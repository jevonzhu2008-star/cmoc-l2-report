expression L2-03-02指标排序 =
		let
		  // 从 SharePoint 站点定位「指标映射」工作簿，读取「日报」Sheet（首行提升为标题）
		  源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
		  指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-03-02 财务费用汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
		  指标排序 = Excel.Workbook(指标映射文件, true){[Item = "指标排序", Kind = "Sheet"]}[Data]
		in
		  指标排序
	lineageTag: c82a7a0b-3ae5-4fe1-80da-6e8171c49168
	queryGroup: 辅助

	annotation PBI_ResultType = Table

