	partition KFM选冶厂月报 = m
		mode: import
		queryGroup: 成本
		source =
				let
				    数据源 = SapBusinessWarehouse.Cubes(服务器, 系统编号, 客户端ID, [LanguageCode="ZH", Implementation="2.0", BatchSize=500000000]),
				    立方体 = 数据源{[Name="ZRPP_CP006"]}[Data],
				    基础查询 = 立方体{[Id="ZRPP_CP006/ZRPP_CP006_Q0002"]}[Data],
				
				    // 按月循环取数：从 p_月报起始日期 到当年 12 月，逐月查询 SAP BW 后合并
				    合并月度数据 = let
				        起始月份 = p_月报起始日期,
				        结束月份 = #date(Date.Year(DateTimeZone.SwitchZone(DateTimeZone.UtcNow(), 8)), 12, 1),
				        月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				        月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				        查询单月 = (month as text) =>
				            let
				                Query = Cube.Transform(基础查询, {
				                    {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZCPL]", {"[4ZRPP_CP006-ZCPL].[LEVEL01]"}, {"产品分类"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZUNIT]", {"[4ZRPP_CP006-ZUNIT].[LEVEL01]"}, {"单位"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZHJ]", {"[4ZRPP_CP006-ZHJ].[LEVEL01]"}, {"环节"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZMAREA]", {"[4ZRPP_CP006-ZMAREA].[LEVEL01]"}, {"矿区"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZSJGX]", {"[4ZRPP_CP006-ZSJGX].[LEVEL01]"}, {"工序代码"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZSJGX_T]", {"[4ZRPP_CP006-ZSJGX_T].[LEVEL01]"}, {"工序"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZINDITEM]", {"[4ZRPP_CP006-ZINDITEM].[LEVEL01]"}, {"指标项"}},
				                    {Cube.AddMeasureColumn, "环比变化%", "[Measures].[4VGQHR12MHZ1PGIPW5ZTU4PVN]"},
				                    {Cube.AddMeasureColumn, "环比实际数", "[Measures].[4VGQHR12MHZ1PGIPW5ZTU4JK3]"},
				                    {Cube.AddMeasureColumn, "累计实际数", "[Measures].[4VGQHR12MHZ1PFWV78XF5HC7D]"},
				                    {Cube.AddMeasureColumn, "累计预测数", "[Measures].[4VGQHR12MHZ1PFWV78XF5HIIX]"},
				                    {Cube.AddMeasureColumn, "累计预算数", "[Measures].[4VGQHR12MHZ1PG2HCQCV38IEL]"},
				                    {Cube.AddMeasureColumn, "全年预算数", "[Measures].[4VGQHR12MHZ1PG2HCQCV38OQ5]"},
				                    {Cube.AddMeasureColumn, "实际数", "[Measures].[4VGQHR12MHZ1PFWV78XF5GZK9]"},
				                    {Cube.AddMeasureColumn, "同比变化%", "[Measures].[4VGQHR12MHZ1PGIPW5ZTU4D8J]"},
				                    {Cube.AddMeasureColumn, "同期实际数", "[Measures].[4VGQHR12MHZ1PGIPW5ZTU46WZ]"},
				                    {Cube.AddMeasureColumn, "预测达成差%", "[Measures].[4VGQHR12MHZ1PGIB7956O16TC]"},
				                    {Cube.AddMeasureColumn, "预测达成率%", "[Measures].[4VGQHR12MHZ1PGIB7956O10HS]"},
				                    {Cube.AddMeasureColumn, "预测数", "[Measures].[4VGQHR12MHZ1PFWV78XF5H5VT]"},
				                    {Cube.AddMeasureColumn, "预算达成差%", "[Measures].[4VGQHR12MHZ1PGIB7956O1JGG]"},
				                    {Cube.AddMeasureColumn, "预算达成率%", "[Measures].[4VGQHR12MHZ1PGIB7956O1D4W]"},
				                    {Cube.AddMeasureColumn, "预算数", "[Measures].[4VGQHR12MHZ1PG2HCQCV38C31]"},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZCX]", {"[4ZRPP_CP006-ZCX].[LEVEL01]"}, {"生产线"}},
				                    {Table.AddColumn, "生产线代码", each Cube.AttributeMemberProperty([生产线], "[24ZRPP_CP006-ZCX]")},
				                    {Table.AddColumn, "矿区代码", each Cube.AttributeMemberProperty([矿区], "[24ZRPP_CP006-ZMAREA]")}
				                }),
				                附加月份 = Table.AddColumn(Query, "月份", each month)
				            in
				                附加月份,
				        各月结果 = List.Transform(月份文本列表, 查询单月),
				        合并结果 = Table.Combine(各月结果)
				    in
				        合并结果,
				
				    // 矿体标识
				    添加矿体列 = Table.AddColumn(合并月度数据, "矿体", each "KFM"),
				
				    // 保留基础列
				    保留列 = Table.SelectColumns(添加矿体列, {"产品分类", "单位", "环节", "矿区", "工序代码", "工序", "环比变化%", "环比实际数", "累计实际数", "累计预测数", "累计预算数", "全年预算数", "实际数", "同比变化%", "同期实际数", "预测达成差%", "预测达成率%", "预测数", "预算达成差%", "预算达成率%", "预算数", "生产线", "生产线代码", "矿区代码", "月份", "矿体", "指标项"}),
				
				    // 左连接月报指标映射，补充类别、序号、总类别、环节序号
				    合并指标映射 = Table.NestedJoin(保留列, {"指标项"}, 月报指标映射, {"指标项"}, "指标映射", JoinKind.LeftOuter),
				    展开指标映射 = Table.ExpandTableColumn(合并指标映射, "指标映射", {"类别", "序号", "环节", "环节序号","指标类别"}, {"类别", "序号", "总类别", "环节序号","指标类别"}),
				
				    // 剔除未匹配到映射的行
				    剔除未匹配行 = Table.SelectRows(展开指标映射, each [序号] <> null),
				
				    // 二级指标：序号 ∈ {1004, 1012, 1013, 1014, 1015} 按 类别+产品分类 细分，其余沿用原类别
				    添加类别2 = Table.AddColumn(剔除未匹配行, "二级指标", each
				        if List.Contains({1004, 1012, 1013, 1014, 1015}, [序号]) then
				                 if [序号] = 1004  and [产品分类] = "全铜TCu" then "采出全铜品位"
				            else if [序号] = 1004  and [产品分类] = "全钴TCo" then "采出全钴品位"
				            else if [序号] = 1012 and [产品分类] = "全铜TCu" then "入选铜品位"
				            else if [序号] = 1012 and [产品分类] = "全钴TCo" then "入选钴品位"
				            else if [序号] = 1013 and [产品分类] = "全铜TCu" then "浸出率TCu"
				            else if [序号] = 1013 and [产品分类] = "全钴TCo" then "浸出率TCo"
				            else if [序号] = 1014 and [产品分类] = "全铜TCu" then "全铜回收率"
				            else if [序号] = 1014 and [产品分类] = "全钴TCo" then "全钴回收率"
				            else if [序号] = 1015 and [产品分类] = "全铜TCu" then "阴极铜"
				            else if [序号] = 1015 and [产品分类] = "全钴TCo" then "氢氧化钴含钴"
				            else null
				        else [类别]
				    ),
				
				    // 排序键 = 序号 × 10 + 铜钴次序（铜 0 钴 1）
				    添加排序键 = Table.AddColumn(添加类别2, "排序", each
				        let
				            主序 = [序号],
				            次序 = if List.Contains({1004, 1012, 1013, 1014, 1015}, [序号]) then
				                if [产品分类] = "全铜TCu" then 0
				                else if [产品分类] = "全钴TCo" then 1
				                else 0
				            else 0
				        in
				            主序 * 10 + 次序
				    ),
				    按排序键排序 = Table.Sort(添加排序键, {{"排序", Order.Ascending}}),
				
				    // 最近月份 = 实际数非空的月份最大值
				    最近月份 = List.Max(Table.SelectRows(按排序键排序, each [实际数] <> null and [实际数] <> 0)[月份]),
				
				    // 日期 = YYYYMM → 当月 1 日
				    添加日期 = Table.AddColumn(按排序键排序, "日期", each
				        if [月份] = null then null
				        else
				            let
				                月份文本 = Text.From([月份]),
				                年 = Number.FromText(Text.Start(月份文本, 4)),
				                月 = Number.FromText(Text.Range(月份文本, 4, 2))
				            in
				                #date(年, 月, 1)
				    ),
				
				    // 月份-筛选器：最近月份 → "最近月份"，其余 → 月份文本
				    添加月份筛选器 = Table.AddColumn(添加日期, "月份-筛选器", each
				        if [月份] = 最近月份 then "最近月份"
				        else if [月份] = null then null
				        else Text.From([月份])
				    ),
				
				  // 收列：直接选定最终字段清单 + 最终顺序，剔除无用【类别】
				    保留最终列 = Table.SelectColumns(添加月份筛选器, {"序号", "环节序号", "排序","总类别", "产品分类", "单位",  "指标类别","指标项", "二级指标", "日期", "月份", "月份-筛选器", "累计实际数", "累计预测数", "累计预算数", "全年预算数", "实际数", "预测数", "预算数"}),
				    // 类型转换
				    设置类型 = Table.TransformColumnTypes(保留最终列, {{"二级指标", type text}, {"月份-筛选器", type text}, {"日期", type date}, {"月份", Int64.Type}, {"环节序号", Int64.Type}, {"排序", Int64.Type}, {"序号", Int64.Type}})
				in
				    设置类型

	annotation PBI_NavigationStepName = 导航

	annotation PBI_ResultType = Table

