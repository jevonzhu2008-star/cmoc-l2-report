	partition 'L2-04-01 库存汇总表' = m
		mode: import
		queryGroup: 财经
		source = ```
				let
				    /*
				    【查询名称】ZRMM_CP002 库存汇总表BW取数
				    【对应报表】L2-04-01 库存汇总表
				    【BW对象】Cube:ZRMM_CP002   Query:ZRMM_CP002_Q0001
				    【说明】
				        1、循环取数：从参数 p_月报起始日期 到 p_月报终止日期，逐月查询BW后合并
				        2、BW参数[ZMSDQNY]：YYYYMM格式年月，返回截止当月的YTD数据
				        3、维度：分类、结构、矿体
				        4、指标：金额(人民币)、量(吨)
				        5、连接参数统一：QAS服务器、系统编号、客户端ID
				        6、读取SharePoint映射表，左连接带出【分类排序】【结构排序】【矿体排序】
				    */
				    
				    // ========== 读取SharePoint上的排序映射表 ==========
				    // 连接财经 SharePoint 站点，列出全部文件（ApiVersion=15 为较新 REST API），结果为文件列表表
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    // 从文件列表筛选名称含该表「…指标映射」且扩展名为 .xlsx 的文件，取第一个并读取其 [Content]（二进制内容）
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-04-01库存汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    // 工作簿只解析一次，后续各 Sheet 直接取用（同一 xlsx 反复解析会拖慢刷新）
				    指标映射工作簿 = Excel.Workbook(指标映射文件, true),
				    分类排序表 = Table.Distinct(Table.TransformColumns(指标映射工作簿{[Item = "分类排序", Kind = "Sheet"]}[Data], {{"分类", each try Text.Trim(Text.From(_)) otherwise _, type text}}), {"分类"}),
				    结构排序表 = Table.Distinct(Table.TransformColumns(指标映射工作簿{[Item = "结构排序", Kind = "Sheet"]}[Data], {{"结构", each try Text.Trim(Text.From(_)) otherwise _, type text}}), {"结构"}),
				    矿体排序表 = Table.Distinct(Table.TransformColumns(指标映射工作簿{[Item = "矿体排序", Kind = "Sheet"]}[Data], {{"矿体", each try Text.Trim(Text.From(_)) otherwise _, type text}}), {"矿体"}),
				    // ========== 连接BW QAS环境 ==========
				    // 连接 BW QAS 环境：Implementation=2.0 新版接口 / LanguageCode=ZH 返回中文 / EnableStructures=true 开启内置结构 / BatchSize 放大提升批量拉取性能
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [LanguageCode="ZH", Implementation="2.0", EnableStructures=true, BatchSize=500000000]),
				    // 按 Cube 名称定位 ZRMM_CP002
				    立方体 = 数据源{[Name="ZRMM_CP002"]}[Data],
				    // 按 Query ID 定位该 Cube 内的目标查询 ZRMM_CP002/ZRMM_CP002_Q0001
				    基础查询 = 立方体{[Id="ZRMM_CP002/ZRMM_CP002_Q0001"]}[Data],
				    
				    // ========== 月份循环配置 ==========
				    // 循环起始月份，取自 Power BI 参数 p_月报起始日期（date 类型）
				    起始月份 = p_月报起始日期,
				    // 循环结束月份，取自 Power BI 参数 p_月报终止日期（date 类型）
				    结束月份 = p_月报终止日期,
				    // 生成连续月份序列：从起始月份起每月 +1，直到不超过结束月份（结果为 date 列表）
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 把每个日期转成 BW 要求的 YYYYMM 文本：年*100+月（如 2026年1月 → "202601"）
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				    
				    // ========== 单月取数函数 ==========
				    // 单月取数函数：输入 YYYYMM 文本，输出该月 BW 查询结果表
				    查询单月 = (month as text) =>
				        let
				            // 对基础查询应用一组 BW 变换：设置期间参数、展开维度、添加度量值
				            Query = Cube.Transform(基础查询, {
				                // BW期间参数
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                
				                // 维度字段展开
				                {Cube.AddAndExpandDimensionColumn, "[4ZRMM_CP002-ZKL]", {"[4ZRMM_CP002-ZKL].[LEVEL01]"}, {"分类"}},
				                {Cube.AddAndExpandDimensionColumn, "[4VGQHR12MHZ3FVOJ91YJ55O51]", {"[4VGQHR12MHZ3FVOJ91YJ55O51]"}, {"结构"}},
				                {Cube.AddAndExpandDimensionColumn, "[ZKT]", {"[ZKT].[LEVEL01]"}, {"矿体"}},
				                
				                // 度量值
				                {Cube.AddMeasureColumn, "金额(人民币)", "[4VGQHR12MHZ3FVOJ91YJ55HTH].[4VGQHR12MHZ3FWDMUA1T7TGC0]"},
				                {Cube.AddMeasureColumn, "量(吨)", "[4VGQHR12MHZ3FVOJ91YJ55HTH].[4VGQHR12MHZ1PLG0H34K5L1JG]"}
				            }),
				            
				            // 维度值统一去首尾空格：BW 返回的分类/结构/矿体偶带空格，与映射表键对不上会丢排序
				            截断维度空格 = Table.TransformColumns(Query, {{"分类", Text.Trim, type text}, {"结构", Text.Trim, type text}, {"矿体", Text.Trim, type text}}),
				            
				            // 增加加载日期列
				            附加月份 = Table.AddColumn(截断维度空格, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date)
				        in
				            附加月份,
				    
				    // 遍历月份，逐个查询
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    
				    // 合并所有月份结果
				    合并结果 = Table.Combine(各月结果),
				    
				    // ========== 左连接映射表，带出三个排序 ==========
				    // 左连接「分类排序」映射表（按业务主键 JoinKind.LeftOuter，未匹配行保留）
				    左连接分类排序 = Table.NestedJoin(合并结果, {"分类"}, 分类排序表, {"分类"}, "分类映射临时", JoinKind.LeftOuter),
				    // 展开临时映射列，带出「分类排序」相关排序字段
				    展开分类排序 = Table.ExpandTableColumn(左连接分类排序, "分类映射临时", {"分类排序"}, {"分类排序"}),
				    
				    // 左连接「结构排序」映射表（按业务主键 JoinKind.LeftOuter，未匹配行保留）
				    左连接结构排序 = Table.NestedJoin(展开分类排序, {"结构"}, 结构排序表, {"结构"}, "结构映射临时", JoinKind.LeftOuter),
				    // 展开临时映射列，带出「结构排序」相关排序字段
				    展开结构排序 = Table.ExpandTableColumn(左连接结构排序, "结构映射临时", {"结构排序"}, {"结构排序"}),
				    
				    // 左连接「矿体排序」映射表（按业务主键 JoinKind.LeftOuter，未匹配行保留）
				    左连接矿体排序 = Table.NestedJoin(展开结构排序, {"矿体"}, 矿体排序表, {"矿体"}, "矿体映射临时", JoinKind.LeftOuter),
				    // 展开临时映射列，带出「矿体排序」相关排序字段
				    展开矿体排序 = Table.ExpandTableColumn(左连接矿体排序, "矿体映射临时", {"矿体排序"}, {"矿体排序"})
				in
				    展开矿体排序
				```

	annotation PBI_ResultType = Table

