	partition 'L2-04-01 库存汇总表' = m
		mode: import
		queryGroup: 财经
		source =
				let
				    /*
				    【查询名称】ZRMM_CP002 库存汇总表 BW 取数
				    【对应报表】L2-04-01库存汇总表
				    【BW对象】Cube:ZRMM_CP002，Query:ZRMM_CP002/ZRMM_CP002_Q0001
				    【说明】
				        1、数据源：SharePoint「L2-04-01库存汇总表指标映射.xlsx」（分类排序 / 结构排序 / 矿体排序 三个 Sheet）+ SAP BW QAS（参数 QAS服务器 / 系统编号 / 客户端ID）
				        2、维度：分类（4ZRMM_CP002-ZKL）、矿体（ZKT），均展开 LEVEL01
				        3、指标：18 个，分金额(人民币)、金额(原币)、量(吨) 三组，每组含当月实际、环比、去年实际、月-1 / 月-2 / 月-3 实际
				        4、月度循环：p_月报起始日期 ~ p_月报终止日期，逐月传 [ZMSDQNY]=YYYYMM（文本）
				        5、清洗：指标列 0 → null（注意与本项目多数表「null → 0」方向相反，真实 0 值也会变空白）；加载日期 = 该月 1 日（date），供日期表关系与切片器筛选
				        6、长表化：逆透视保留 分类 / 矿体 / 加载日期，其余 18 个指标列转为 指标名称 / 指标值
				        7、排序：依次左连接 分类排序 / 结构排序 / 矿体排序 三张映射 Sheet，带出同名列的排序号
				        8、本表特有：每个月除明细行外，按【分类 + 加载日期 + 指标名称】生成「矿体 = 集团合计」汇总行（剔除 矿体='未分配'）后追加回明细；再把 指标名称 按空格拆成 指标名称 / 结构（如「金额(人民币) 当月实际」）；另加 矿体v 副本列（当前报表未引用）
				    */
				    // ========== 1. 连接 BW QAS，Cube 与 Query 只实例化一次 ==========
				    // 连接 BW QAS 服务器；本表只传 Implementation=2.0，未带 LanguageCode / EnableStructures / BatchSize（其余事实表大多有），出现语言或结构异常时先查这里
				    源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID , [Implementation="2.0"]),
				    // 按 Cube 名称取出 ZRMM_CP002 的元数据
				    ZRMM_CP002 = 源{[Name="ZRMM_CP002"]}[Data],
				    // 按 Query Id 定位取数查询 ZRMM_CP002/ZRMM_CP002_Q0001；BW 会话只在这里建一次，循环内只做 Cube.Transform
				    Cube = ZRMM_CP002{[Id="ZRMM_CP002/ZRMM_CP002_Q0001"]}[Data],
				
				    // ========== 2. 读取 SharePoint 排序映射工作簿 ==========
				    // 连接财经 SharePoint 站点取文件清单；ApiVersion=15 走新版 REST 接口
				    源2 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    // 按文件名含「L2-04-01库存汇总表指标映射」且扩展名为 .xlsx 筛选，取第一个匹配文件的二进制内容
				    指标映射文件 = Table.SelectRows(源2, each Text.Contains([Name], "L2-04-01库存汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    // 工作簿只解析一次，三张排序 Sheet 共用，避免重复解析 Excel 拖慢刷新
				    指标映射工作簿 = Excel.Workbook(指标映射文件, true),
				    // 读取【分类排序】Sheet：Text.Trim 去首尾空格并强制转 text（防止 Excel 把编码读成数值），再按「分类」去重，保证与事实行一对一、不放大行数
				    分类排序表 = Table.Distinct(Table.TransformColumns(指标映射工作簿{[Item = "分类排序", Kind = "Sheet"]}[Data], {{"分类", each try Text.Trim(Text.From(_)) otherwise _, type text}}), {"分类"}),
				    // 读取【结构排序】Sheet：同样清洗空格、转 text 后按「结构」去重
				    结构排序表 = Table.Distinct(Table.TransformColumns(指标映射工作簿{[Item = "结构排序", Kind = "Sheet"]}[Data], {{"结构", each try Text.Trim(Text.From(_)) otherwise _, type text}}), {"结构"}),
				    // 读取【矿体排序】Sheet：同样清洗后按「矿体」去重；「集团合计」行也要在这张表里维护排序号，否则合计行排不上
				    矿体排序表 = Table.Distinct(Table.TransformColumns(指标映射工作簿{[Item = "矿体排序", Kind = "Sheet"]}[Data], {{"矿体", each try Text.Trim(Text.From(_)) otherwise _, type text}}), {"矿体"}),
				
				    // ========== 3. 生成月份循环区间 ==========
				    // 起始月 = 参数 p_月报起始日期（date 类型）
				    起始月份 = p_月报起始日期,
				    // 结束月 = 参数 p_月报终止日期（date 类型，当前为手写值，跨月后需手动往后调）
				    结束月份 = p_月报终止日期,
				    // 生成含首尾的逐月 date 序列
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 转成 BW 参数要求的 YYYYMM 文本（2026-06-01 → "202606"）；循环变量必须是文本，不能直接写进日期列
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				
				    // ========== 4. 单月取数函数：BW 取数 → 加载日期 → 0 转 null → 逆透视 → 集团合计 ==========
				    // 入参 month 为 YYYYMM 文本；返回当月「明细 + 集团合计」的长表
				    取单月 = (month as text) as table =>
				        let
				            // 对已定位的 Query 执行变换链：先传期间参数，再展开维度、挂指标
				            添加的项 = Cube.Transform(Cube,
				                {
				                    // 给 BW 变量 ZMSDQNY 传当前月份（YYYYMM 文本）
				                    {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                    // 展开维度 4ZRMM_CP002-ZKL 的 LEVEL01，别名「分类」
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRMM_CP002-ZKL]", {"[4ZRMM_CP002-ZKL].[LEVEL01]"}, {"分类"}},
				                    // 展开维度 ZKT 的 LEVEL01，别名「矿体」
				                    {Cube.AddAndExpandDimensionColumn, "[ZKT]", {"[ZKT].[LEVEL01]"}, {"矿体"}},
				                    // 【指标组】金额(人民币)：当月实际 / 环比 / 去年实际 / 月-1 / 月-2 / 月-3 实际
				                    {Cube.AddMeasureColumn, "金额(人民币) 当月实际", "[Measures].[4VGQHR12MHZ3FWDMUA1T7TGC04VGQHR12MHZ3FVOJ91YJ560S5]"}, // 本月库存金额（人民币）
				                    {Cube.AddMeasureColumn, "金额(人民币) 环比", "[Measures].[4VGQHR12MHZ3FWDMUA1T7TGC04VGQHR12MHZ1PLARX5QW4YR6E]"}, // 与上月对比（金额口径）
				                    {Cube.AddMeasureColumn, "金额(人民币) 去年实际", "[Measures].[4VGQHR12MHZ3FWDMUA1T7TGC04VGQHR12MHZ3FWDMUA1T7TA0G]"}, // 上年同期实际
				                    {Cube.AddMeasureColumn, "金额(人民币) 月-1实际", "[Measures].[4VGQHR12MHZ3FWDMUA1T7TGC04VGQHR12MHZ1PLYB03BDBK19L]"}, // 前 1 个月实际
				                    {Cube.AddMeasureColumn, "金额(人民币) 月-2实际", "[Measures].[4VGQHR12MHZ3FWDMUA1T7TGC04VGQHR12MHZ1PLYB03BDBJUY1]"}, // 前 2 个月实际
				                    {Cube.AddMeasureColumn, "金额(人民币) 月-3实际", "[Measures].[4VGQHR12MHZ3FWDMUA1T7TGC04VGQHR12MHZ1PLYB03BDBJOMH]"}, // 前 3 个月实际
				                    // 【指标组】金额(原币)：结构与人民币组一一对应，只是币种不同
				                    {Cube.AddMeasureColumn, "金额(原币) 当月实际", "[Measures].[4VGQHR12MHZ3FWDSL9T0KCND84VGQHR12MHZ3FVOJ91YJ560S5]"}, // 本月库存金额（原币）
				                    {Cube.AddMeasureColumn, "金额(原币) 环比", "[Measures].[4VGQHR12MHZ3FWDSL9T0KCND84VGQHR12MHZ1PLARX5QW4YR6E]"}, // 与上月对比（原币）
				                    {Cube.AddMeasureColumn, "金额(原币) 去年实际", "[Measures].[4VGQHR12MHZ3FWDSL9T0KCND84VGQHR12MHZ3FWDMUA1T7TA0G]"}, // 上年同期实际（原币）
				                    {Cube.AddMeasureColumn, "金额(原币) 月-1实际", "[Measures].[4VGQHR12MHZ3FWDSL9T0KCND84VGQHR12MHZ1PLYB03BDBK19L]"}, // 前 1 个月实际（原币）
				                    {Cube.AddMeasureColumn, "金额(原币) 月-2实际", "[Measures].[4VGQHR12MHZ3FWDSL9T0KCND84VGQHR12MHZ1PLYB03BDBJUY1]"}, // 前 2 个月实际（原币）
				                    {Cube.AddMeasureColumn, "金额(原币) 月-3实际", "[Measures].[4VGQHR12MHZ3FWDSL9T0KCND84VGQHR12MHZ1PLYB03BDBJOMH]"}, // 前 3 个月实际（原币）
				                    // 【指标组】量(吨)：库存数量，口径同样分当月实际、环比、去年实际、月-1~3 实际
				                    {Cube.AddMeasureColumn, "量(吨) 当月实际", "[Measures].[4VGQHR12MHZ1PLG0H34K5L1JG4VGQHR12MHZ3FVOJ91YJ560S5]"}, // 本月库存量（吨）
				                    {Cube.AddMeasureColumn, "量(吨) 环比", "[Measures].[4VGQHR12MHZ1PLG0H34K5L1JG4VGQHR12MHZ1PLARX5QW4YR6E]"}, // 与上月对比（数量）
				                    {Cube.AddMeasureColumn, "量(吨) 去年实际", "[Measures].[4VGQHR12MHZ1PLG0H34K5L1JG4VGQHR12MHZ3FWDMUA1T7TA0G]"}, // 上年同期实际（数量）
				                    {Cube.AddMeasureColumn, "量(吨) 月-1实际", "[Measures].[4VGQHR12MHZ1PLG0H34K5L1JG4VGQHR12MHZ1PLYB03BDBK19L]"}, // 前 1 个月实际（数量）
				                    {Cube.AddMeasureColumn, "量(吨) 月-2实际", "[Measures].[4VGQHR12MHZ1PLG0H34K5L1JG4VGQHR12MHZ1PLYB03BDBJUY1]"}, // 前 2 个月实际（数量）
				                    {Cube.AddMeasureColumn, "量(吨) 月-3实际", "[Measures].[4VGQHR12MHZ1PLG0H34K5L1JG4VGQHR12MHZ1PLYB03BDBJOMH]"} // 前 3 个月实际（数量）
				                }
				            ),
				            // 追加「加载日期」：用 #date 从 YYYYMM 文本单独构造当月 1 日（date 类型）；month 是文本，不能直接赋给日期列。该列与日期表建关系，供「年月筛选」切片器联动
				            附加月份 = Table.AddColumn(添加的项, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date),
				            // 指标列中的 0 统一替换成 null（只作用于下面 18 个指标列，维度文本列保留），避免 0 与「无数据」混淆；注意方向是 0 → null，与多数表相反
				            已替换值 = Table.ReplaceValue(附加月份, 0, null, Replacer.ReplaceValue,
				                {
				                    "金额(人民币) 当月实际", "金额(人民币) 环比", "金额(人民币) 去年实际",
				                    "金额(人民币) 月-1实际", "金额(人民币) 月-2实际", "金额(人民币) 月-3实际",
				                    "金额(原币) 当月实际", "金额(原币) 环比", "金额(原币) 去年实际",
				                    "金额(原币) 月-1实际", "金额(原币) 月-2实际", "金额(原币) 月-3实际",
				                    "量(吨) 当月实际", "量(吨) 环比", "量(吨) 去年实际",
				                    "量(吨) 月-1实际", "量(吨) 月-2实际", "量(吨) 月-3实际"
				                }
				            ),
				            // 宽表转长表：保留 分类 / 矿体 / 加载日期，其余 18 个指标列逆透视成「指标名称」「指标值」
				            已逆透视其他列 = Table.UnpivotOtherColumns(已替换值, {"分类", "矿体", "加载日期"}, "指标名称", "指标值"),
				
				            // 汇总口径：剔除 矿体='未分配' 的行（未分配不属于任何矿体，不计入集团合计）
				            已筛选行 = Table.SelectRows(已逆透视其他列, each ([矿体] <> "未分配")),
				            // 按 分类 + 加载日期 + 指标名称 对指标值求和；指标值显式声明 type any，便于与明细表直接 Combine
				            分组的行 = Table.Group(已筛选行, {"分类", "加载日期", "指标名称"}, {{"指标值", each List.Sum([指标值]), type any}}),
				            // 给合计行打上 矿体 = "集团合计" 标识
				            // ⚠ 待核对：原注释写「矿体=合计」，代码实际是「集团合计」，上线前确认报表侧与映射表取值一致。
				            已添加自定义 = Table.AddColumn(分组的行, "矿体", each "集团合计"),
				            // 合计行按 分类 / 矿体 / 加载日期 / 指标名称 / 指标值 统一列序，便于与明细表纵向合并
				            已重新排序列 = Table.ReorderColumns(已添加自定义, {"分类", "矿体", "加载日期", "指标名称", "指标值"}),
				            // 先放集团合计行、再接当月明细；Table.Combine 按列名对齐，列序不影响结果。只有合计口径剔除了「未分配」，明细部分仍保留
				            已追加明细合计 = Table.Combine({已重新排序列, 已逆透视其他列})
				        in
				            // 返回当月明细 + 集团合计
				            已追加明细合计,
				
				    // ========== 5. 逐月循环并合并全部月份 ==========
				    // 对每个月文本调用 取单月，再把各月长表纵向合并成全期表
				    所有月份表 = Table.Combine(List.Transform(月份文本列表, 取单月)),
				
				    // ========== 6. 拆分指标名称为 指标名称 / 结构 ==========
				    // BW 度量名本身是「指标 + 空格 + 结构」格式，按空格拆开；结构 列用于报表区分当月 / 环比 / 去年 / 月-1~3 等口径
				    按分隔符拆分列 = Table.SplitColumn(所有月份表, "指标名称", Splitter.SplitTextByDelimiter(" "), {"指标名称", "结构"}),
				
				    // ========== 7. 增加 矿体v 副本列 ==========
				    // 复制 矿体 到 矿体v（沿用 矿体排序 排序）；当前报表页面未引用，属预留列
				    已添加自定义 = Table.AddColumn(按分隔符拆分列, "矿体v", each [矿体]),
				
				    // ========== 8. 依次左连接 3 张排序映射表 ==========
				    // 左连接分类排序：按「分类」匹配，JoinKind.LeftOuter 保留全部事实行；映射表读取时已去重，避免一对多放大行数
				    左连接分类排序 = Table.NestedJoin(已添加自定义, {"分类"}, 分类排序表, {"分类"}, "分类映射临时", JoinKind.LeftOuter),
				    // 只把排序列「分类排序」展开回主表，其他映射列不带入
				    展开分类排序 = Table.ExpandTableColumn(左连接分类排序, "分类映射临时", {"分类排序"}, {"分类排序"}),
				    // 左连接结构排序：按「结构」匹配，JoinKind.LeftOuter；结构映射表已按结构去重
				    左连接结构排序 = Table.NestedJoin(展开分类排序, {"结构"}, 结构排序表, {"结构"}, "结构映射临时", JoinKind.LeftOuter),
				    // 只展开「结构排序」
				    展开结构排序 = Table.ExpandTableColumn(左连接结构排序, "结构映射临时", {"结构排序"}, {"结构排序"}),
				    // 左连接矿体排序：按「矿体」匹配，JoinKind.LeftOuter；映射表需同时维护真实矿体与「集团合计」
				    左连接矿体排序 = Table.NestedJoin(展开结构排序, {"矿体"}, 矿体排序表, {"矿体"}, "矿体映射临时", JoinKind.LeftOuter),
				    // 只展开「矿体排序」；映射缺失时为 null，报表排序会落到末尾
				    展开矿体排序 = Table.ExpandTableColumn(左连接矿体排序, "矿体映射临时", {"矿体排序"}, {"矿体排序"})
				in
				    // 最终输出：长表 + 结构列 + 三张排序字段，供报表矩阵与切片器使用
				    展开矿体排序

	annotation PBI_ResultType = Table

