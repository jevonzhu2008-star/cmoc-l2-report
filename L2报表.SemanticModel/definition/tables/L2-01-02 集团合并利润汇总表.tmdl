	partition 'L2-01-02 集团合并利润汇总表' = m
		mode: import
		queryGroup: 财经\多月
		source =
				let
				    /*
				    【查询名称】ZRFI_CP011 集团合并利润汇总表 BW取数
				    【对应报表】L2‑01‑02 集团合并利润汇总表
				    【BW对象】Cube:ZRFI_CP011   Query:ZRFI_CP011_Q0001
				    【说明】
				        1、循环取数：从参数 p_月报起始日期 开始，取到 p_月报终止日期，逐月查询BW后合并成长表
				        2、BW参数[ZMSDQNY]：YYYYMM格式年月，BW根据该参数自动返回截止该月的YTD数据
				        3、维度：利润表项目（Structure内置）
				        4、指标：YTD累计指标 + 1‑12月分月度量 + MTD当月/上月/环比指标
				        5、连接参数统一：QAS服务器、系统编号、客户端ID，和项目其他BW查询保持一套参数规范
				        6、EnableStructures=true 必须开启，否则内置Structure行维度无法解析
				        7、末尾逆透视分月列、添加月份排序，统一长表结构，方便矩阵报表排序展示
				        8、【季度】由【月份排序】1~12计算，代表该行分月所属季度
				        9、新增：读取SharePoint指标映射表，左连接【结构】字段，带出【结构排序】
				    */
				    // ========== 读取SharePoint上的结构排序映射表 ==========
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-01-02 集团合并利润汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    结构排序映射表 = Excel.Workbook(指标映射文件, true){[Item = "结构排序", Kind = "Sheet"]}[Data],
				    // 1、连接BW QAS环境
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [Implementation="2.0", LanguageCode="ZH", EnableStructures=true, BatchSize=500000000]),
				    // 2、定位Cube与目标BW查询
				    立方体 = 数据源{[Name="ZRFI_CP011"]}[Data],
				    基础查询 = 立方体{[Id="ZRFI_CP011/ZRFI_CP011_Q0001"]}[Data],
				    // ========== 月份循环配置 ==========
				    // 月报起始月份，取自PowerBI参数 p_月报起始日期
				    起始月份 = p_月报起始日期,
				    // 结束月份：当年12月1日
				    结束月份 = p_月报终止日期,
				    // 生成连续月份序列
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 转换为BW要求的 YYYYMM 文本格式
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				    // 单月取数函数：输入年月文本，返回当月BW查询结果，并追加月份标记列
				    查询单月 = (month as text) =>
				        let
				            Query = Cube.Transform(基础查询, {
				                // BW期间参数，传入当前循环年月
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                // ========== 展开内置结构维度 利润表项目，输出列名：结构 ==========
				                {Cube.AddAndExpandDimensionColumn, "[4VGQHR12MHZ3FU4L96KDFQ9OO]", {"[4VGQHR12MHZ3FU4L96KDFQ9OO]"}, {"结构"}},
				                // ========== YTD累计类指标（截止参数所选月份） ==========
				                {Cube.AddMeasureColumn, "当月YTD", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4L96KDFR5AG]"},     // 实际归母净利 YTD
				                {Cube.AddMeasureColumn, "同比YTD", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4L96KDFRO94]"},     // YTD同比变化%
				                {Cube.AddMeasureColumn, "去年同期YTD", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4L96KDFRUKO]"},  // 上一年同期YTD实际
				                {Cube.AddMeasureColumn, "预算YTD", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4L96KDFS0W8]"},     // YTD预算
				                {Cube.AddMeasureColumn, "预算达成率", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4L96KDFS77S]"},   // YTD预算达成率
				                // ========== 1‑12月分月度量列（BW预生成宽表列，用于报表Q1/Q2分月展示） ==========
				                {Cube.AddMeasureColumn, "1月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4L96KDFSDJC]"},
				                {Cube.AddMeasureColumn, "2月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMNFB7]"},
				                {Cube.AddMeasureColumn, "3月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMNLMR]"},
				                {Cube.AddMeasureColumn, "4月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMNRYB]"},
				                {Cube.AddMeasureColumn, "5月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMNY9V]"},
				                {Cube.AddMeasureColumn, "6月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMO4LF]"},
				                {Cube.AddMeasureColumn, "7月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMOAWZ]"},
				                {Cube.AddMeasureColumn, "8月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMOH8J]"},
				                {Cube.AddMeasureColumn, "9月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMONK3]"},
				                {Cube.AddMeasureColumn, "10月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMOTVN]"},
				                {Cube.AddMeasureColumn, "11月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMP077]"},
				                {Cube.AddMeasureColumn, "12月", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMP6IR]"},
				                // ========== MTD当月环比类指标 ==========
				                {Cube.AddMeasureColumn, "环比MTD", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMPCUB]"},     // 当月MTD相对上月MTD环比%
				                {Cube.AddMeasureColumn, "当月MTD", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMPJ5V]"},     // 参数所选月份当月实际
				                {Cube.AddMeasureColumn, "上月MTD", "[4VGQHR12MHZ3FU4L96KDFPQQ0].[4VGQHR12MHZ3FU4MVP8LMPPHF]"}      // 参数所选月份的上一个月实际
				            }),
				            // 【可选】获取维度成员唯一ID MEMBER_UNIQUE_NAME
				            添加结构唯一ID = Table.AddColumn(Query, "结构唯一ID", each Cube.AttributeMemberProperty([结构], "[MEMBER_UNIQUE_NAME]")),
				            // 增加加载年月字段（YYYYMM），标记本条数据对应的查询期间
				            附加月份 = Table.AddColumn(添加结构唯一ID, "加载年月", each month),
				            // 空值替换为0
				            空值替换为0 = Table.ReplaceValue(
				            	附加月份,
				            	null,
				            	0,
				            	Replacer.ReplaceValue,
				            	{"结构","结构唯一ID","当月YTD", "同比YTD", "去年同期YTD", "预算YTD", "预算达成率", "1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月", "环比MTD", "当月MTD", "上月MTD", "加载年月"}
				            ),
				            // 逆透视分月列，1~12月转为行
				            逆透视分月列 = Table.UnpivotOtherColumns(空值替换为0, {"结构","结构唯一ID","环比MTD", "当月MTD", "上月MTD", "加载年月", "预算达成率", "预算YTD", "去年同期YTD", "同比YTD", "当月YTD"}, "月份", "实际值"),
				            // 月份排序
				            添加月份排序 = Table.AddColumn(逆透视分月列, "月份排序", each
				                if [月份] = "1月" then 1
				                else if [月份] = "2月" then 2
				                else if [月份] = "3月" then 3
				                else if [月份] = "4月" then 4
				                else if [月份] = "5月" then 5
				                else if [月份] = "6月" then 6
				                else if [月份] = "7月" then 7
				                else if [月份] = "8月" then 8
				                else if [月份] = "9月" then 9
				                else if [月份] = "10月" then 10
				                else if [月份] = "11月" then 11
				                else if [月份] = "12月" then 12
				                else 999
				            , Int64.Type),
				            // ✅ 根据【月份排序】计算季度 Q1/Q2/Q3/Q4
				            添加季度 = Table.AddColumn(添加月份排序, "季度", each
				                let
				                    mSort = [月份排序]
				                in
				                    if mSort <= 3 then "Q1"
				                    else if mSort <= 6 then "Q2"
				                    else if mSort <= 9 then "Q3"
				                    else if mSort <= 12 then "Q4"
				                    else null
				            , type text)
				        in
				        添加季度,
				    // 遍历月份列表，逐个执行单月查询
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    // 将所有月份结果合并为一张长表
				    合并结果 = Table.Combine(各月结果),
				    // ========== 左连接映射表，带出【结构排序】 ==========
				    // 关联键：[结构]（利润项目名称）
				    左连接结构排序 = Table.NestedJoin(合并结果, {"结构唯一ID"}, 结构排序映射表, {"结构UniqueName"}, "映射临时", JoinKind.LeftOuter),
				    展开结构排序 = Table.ExpandTableColumn(左连接结构排序, "映射临时", {"结构排序"}, {"结构排序"})
				in
				    展开结构排序

	annotation PBI_ResultType = Table

