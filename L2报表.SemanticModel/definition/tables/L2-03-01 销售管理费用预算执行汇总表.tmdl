	partition 'L2-03-01 销售管理费用预算执行汇总表' = m
		mode: import
		queryGroup: 财经
		source =
				let
				    /*
				    【查询名称】ZRFI_CP005 销管费用BW取数
				    【对应报表】L2销管费用月报
				    【BW对象】Cube:ZRFI_CP005   Query:ZRFI_CP005_Q0002
				    【说明】
				        1、循环取数：从参数 p_月报起始日期 开始，取到 p_月报终止日期，逐月查询BW后合并成长表
				        2、BW参数[ZMSDQNY]：YYYYMM格式年月，返回截止当月YTD累计指标
				        3、维度：公司名称(显示名称)、销管费分类、管理口径利润中心
				        4、【公司代码】：存放纯编码；【利润中心代码】：利润中心编码
				        5、业务板块：3级分步匹配，优先级：双键(利润中心代码+公司代码) > 仅利润中心代码 > 仅公司代码
				        6、外部映射Sheet【业务板块映射】表头：利润中心代码,公司代码,业务板块
				        7、新增：业务板块排序表，同一份Excel内Sheet【业务板块排序】
				    */
				    // ========== 读取SharePoint上的全部映射表 ==========
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-03-01 销售管理费用预算执行汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    // 原有三张排序映射表
				    公司代码排序表 = Excel.Workbook(指标映射文件, true){[Item = "公司代码排序", Kind = "Sheet"]}[Data],
				    销管费分类排序表 = Excel.Workbook(指标映射文件, true){[Item = "销管费分类排序", Kind = "Sheet"]}[Data],
				    管理口径利润中心排序表 = Excel.Workbook(指标映射文件, true){[Item = "管理口径利润中心排序", Kind = "Sheet"]}[Data],
				    // ===== 新增：业务板块排序表 =====
				    业务板块排序表 = Excel.Workbook(指标映射文件, true){[Item = "业务板块排序", Kind = "Sheet"]}[Data],
				    // ===== 新增：读取业务板块映射表 =====
				    业务板块映射表 = Excel.Workbook(指标映射文件, true){[Item = "业务板块映射", Kind = "Sheet"]}[Data],
				    已更改列类型 = Table.TransformColumnTypes(业务板块映射表, {{"公司代码", type text}}),
				    // 拆分映射表为3个子集，对应三级匹配规则
				    映射_双键 = Table.SelectRows(已更改列类型, each [利润中心代码]<>null and [公司代码]<>null),
				    映射_仅利润中心代码 = Table.SelectRows(已更改列类型, each [利润中心代码]<>null and [公司代码]=null),
				    映射_仅公司代码 = Table.SelectRows(已更改列类型, each [利润中心代码]=null and [公司代码]<>null),
				    // 1、连接BW QAS环境
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [LanguageCode="ZH", Implementation="2.0", BatchSize=500000000]),
				    // 2、定位Cube与目标BW查询
				    立方体 = 数据源{[Name="ZRFI_CP005"]}[Data],
				    基础查询 = 立方体{[Id="ZRFI_CP005/ZRFI_CP005_Q0002"]}[Data],
				    // ========== 月份循环配置 ==========
				    起始月份 = p_月报起始日期,
				    结束月份 = p_月报终止日期,
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				    // 单月取数函数
				    查询单月 = (month as text) =>
				        let
				            Query = Cube.Transform(基础查询, {
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                {Cube.AddMeasureColumn, "累计实际", "[Measures].[4VGQHR12MHZ3FT2S9KPZM93SH]"},
				                // {Cube.AddMeasureColumn, "累计实际(千人民币)", "[Measures].[4VGQHR12MHZ3FT2S9KPZM9A41]"},
				                {Cube.AddMeasureColumn, "累计预算", "[Measures].[4VGQHR12MHZ3FT2S9KPZM9GFL]"},
				                // {Cube.AddMeasureColumn, "累计执行%", "[Measures].[4VGQHR12MHZ3FT2S9KPZM9MR5]"},
				                {Cube.AddAndExpandDimensionColumn, "[ZBUKRS]", {"[ZBUKRS].[LEVEL01]"}, {"公司名称"}},
				                {Cube.AddAndExpandDimensionColumn, "[ZXGFFL]", {"[ZXGFFL].[LEVEL01]"}, {"销管费分类"}},
				                {Cube.AddAndExpandDimensionColumn, "[ZPRCTR_GL]", {"[ZPRCTR_GL].[LEVEL01]"}, {"管理口径利润中心"}}
				            }),
				            // ✅ 字段和你原有保持不变：公司代码、销管费分类代码、利润中心代码
				            添加公司代码 = Table.AddColumn(Query, "公司代码", each Cube.AttributeMemberProperty([公司名称], "[2ZBUKRS]")),
				            添加销管费分类代码 = Table.AddColumn(添加公司代码, "销管费分类代码", each Cube.AttributeMemberProperty([销管费分类], "[2ZXGFFL]")),
				            添加利润中心代码 = Table.AddColumn(添加销管费分类代码, "利润中心代码", each Cube.AttributeMemberProperty([管理口径利润中心], "[2ZPRCTR_GL]")),
				            附加月份 = Table.AddColumn(添加利润中心代码, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date)
				        in
				            附加月份,
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    合并结果 = Table.Combine(各月结果),
				    左连接分类排序 = Table.NestedJoin(合并结果, {"销管费分类"}, 销管费分类排序表, {"销管费分类"}, "分类映射临时", JoinKind.LeftOuter),
				    展开分类排序 = Table.ExpandTableColumn(左连接分类排序, "分类映射临时", {"销管费分类排序"}, {"销管费分类排序"}),
				    // ========= 分步三级匹配（优先级：双键>仅利润中心代码>仅公司代码） =========
				    // 第1级：利润中心代码 + 公司代码 双键匹配（最高优先级）
				    阶段1_关联 = Table.NestedJoin(展开分类排序,{"利润中心代码","公司代码"},映射_双键,{"利润中心代码","公司代码"},"tmp1",JoinKind.LeftOuter),
				    阶段1_展开 = Table.ExpandTableColumn(阶段1_关联,"tmp1",{"业务板块"},{"业务板块"}),
				    // 第2级：未匹配到的，只用利润中心代码匹配
				    阶段2_关联 = Table.NestedJoin(阶段1_展开,{"利润中心代码"},映射_仅利润中心代码,{"利润中心代码"},"tmp2",JoinKind.LeftOuter),
				    阶段2_填充 = Table.AddColumn(阶段2_关联, "业务板块_阶段2", each if [业务板块] = null then try [tmp2][业务板块]{0} otherwise null else [业务板块]),
				    阶段2_清理 = Table.RemoveColumns(阶段2_填充,{"业务板块","tmp2"}),
				    阶段2_重命名 = Table.RenameColumns(阶段2_清理,{{"业务板块_阶段2","业务板块"}}),
				    // 第3级：仍然为空的，只用公司代码匹配
				    阶段3_关联 = Table.NestedJoin(阶段2_重命名,{"公司代码"},映射_仅公司代码,{"公司代码"},"tmp3",JoinKind.LeftOuter),
				    阶段3_填充 = Table.AddColumn(阶段3_关联, "业务板块_阶段3", each if [业务板块] = null then try [tmp3][业务板块]{0} otherwise null else [业务板块]),
				    阶段3_清理 = Table.RemoveColumns(阶段3_填充,{"业务板块","tmp3"}),
				    阶段3_重命名 = Table.RenameColumns(阶段3_清理,{{"业务板块_阶段3","业务板块"}}),
				    // 兜底：全部匹配不到填 待定
				    兜底填充 = Table.ReplaceValue(阶段3_重命名,null,"待定",Replacer.ReplaceValue,{"业务板块"}),
				    // 关联业务板块排序
				    关联业务板块排序 = Table.NestedJoin(兜底填充,{"业务板块"},业务板块映射表,{"业务板块"},"板块排序临时",JoinKind.LeftOuter),
				    展开业务板块排序 = Table.ExpandTableColumn(关联业务板块排序, "板块排序临时", {"业务板块排序"}, {"业务板块排序"})
				in
				    展开业务板块排序

	annotation PBI_ResultType = Table

