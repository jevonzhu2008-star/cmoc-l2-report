	column 业务板块排序
		dataType: double
		isHidden
		lineageTag: 21890e3d-9154-434a-b9f5-a352db012aad
		summarizeBy: sum
		sourceColumn: 业务板块排序

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'L2-03-01 销售管理费用预算执行汇总表' = m
		mode: import
		queryGroup: 财经
		source =
				let
				    /*
				    【查询名称】L2-03-01 销售管理费用预算执行汇总表 BW 取数
				    【对应报表】L2-03-01 销售管理费用预算执行汇总表
				    【BW对象】Cube:ZRFI_CP005，Query:ZRFI_CP005/ZRFI_CP005_Q0002
				    【说明】
				        1、数据源：SharePoint「L2-03-01 销售管理费用预算执行汇总表指标映射」+ SAP BW QAS（参数 QAS服务器 / 系统编号 / 客户端ID）
				        2、维度：公司名称（ZBUKRS）、销管费分类（ZXGFFL）、管理口径利润中心（ZPRCTR_GL）；另用 Cube.AttributeMemberProperty 取回匹配键 公司代码（2ZBUKRS）、销管费分类代码（2ZXGFFL）、利润中心代码（2ZPRCTR_GL）
				        3、指标：累计实际、累计预算；BW 侧按 [ZMSDQNY] 返回截止当月的 YTD 累计口径
				        4、月度循环：p_月报起始日期 ~ p_月报终止日期，逐月传 [ZMSDQNY]=YYYYMM（文本，不是日期）
				        5、清洗：本表不做 null → 0，金额保持 BW 原始空值；加载日期 = 该月 1 日（date），供日期表关系与切片器筛选
				        6、长表化：无。本表保持宽表（累计预算 / 累计实际两列），不逆透视
				        7、排序：左连接「销管费分类排序」「业务板块映射」两张映射表，带出销管费分类排序、业务板块排序
				        8、本表特有：业务板块三级匹配（双键 > 仅利润中心代码 > 仅公司代码，全落空填「待定」）；再按 销管费分类排序 + 加载日期 + 销管费分类 汇总出「业务板块 = 集团合计」行，与明细合并后只保留 业务板块、销管费分类排序、加载日期、销管费分类、累计预算、累计实际 六列
				    */
				    // ========== 1. 读取 SharePoint 映射工作簿并预处理匹配键 ==========
				    // 站点文件清单，ApiVersion=15 走新版 REST 接口
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    // 按文件名关键字取本表映射 xlsx 的二进制内容
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-03-01 销售管理费用预算执行汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    // 工作簿只解析一次，后面各 Sheet 共用
				    指标映射工作簿 = Excel.Workbook(指标映射文件, true),

				    // 本表需要的 Sheet：销管费分类排序、业务板块映射（排序表与三级匹配键都从后者派生）
				    // 销管费分类排序：按「销管费分类」去重，保证与事实表 1:1 连接
				    销管费分类排序表 = Table.Distinct(指标映射工作簿{[Item = "销管费分类排序", Kind = "Sheet"]}[Data], {"销管费分类"}),
				    // 业务板块原始映射：下面三种匹配变体都从这一张 Sheet 派生
				    业务板块原始映射 = 指标映射工作簿{[Item = "业务板块映射", Kind = "Sheet"]}[Data],
				    // 业务板块排序：先滤掉空板块再按「业务板块」去重；同一板块多行时只保留首条的排序值
				    业务板块排序表 = Table.Distinct(Table.SelectRows(业务板块原始映射, each [业务板块] <> null), {"业务板块"}),

				    // 匹配键统一转 text：Excel 会把纯数字的公司 / 利润中心代码推断成数值，与 BW 返回的文本编码对不上
				    映射_规范化 = Table.TransformColumnTypes(业务板块原始映射, {{"利润中心代码", type text}, {"公司代码", type text}, {"业务板块", type text}}),
				    // 双键变体：利润中心代码 + 公司代码都非空，按双键去重，保证一条映射只命中一次
				    映射_双键 = Table.Distinct(Table.SelectRows(映射_规范化, each [利润中心代码] <> null and [公司代码] <> null), {"利润中心代码", "公司代码"}),
				    // 仅利润中心代码：公司代码为空的行，按利润中心代码去重；两列皆空的映射行不参与任何一级匹配
				    映射_仅利润中心代码 = Table.Distinct(Table.SelectRows(映射_规范化, each [利润中心代码] <> null and [公司代码] = null), {"利润中心代码"}),
				    // 仅公司代码：利润中心代码为空的行，按公司代码去重
				    映射_仅公司代码 = Table.Distinct(Table.SelectRows(映射_规范化, each [利润中心代码] = null and [公司代码] <> null), {"公司代码"}),

				    // ========== 2. 连接 BW QAS 数据源 ==========
				    // 新版实现 + 中文返回 + 大批量拉取；Cube 在循环外只实例化一次，循环里只做 Cube.Transform
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [LanguageCode="ZH", Implementation="2.0", BatchSize=500000000]),
				    // 定位目标 Cube ZRFI_CP005
				    立方体 = 数据源{[Name="ZRFI_CP005"]}[Data],
				    // 定位该 Cube 下的取数 Query（销管费用预算执行）
				    基础查询 = 立方体{[Id="ZRFI_CP005/ZRFI_CP005_Q0002"]}[Data],

				    // ========== 3. 生成月份序列 ==========
				    // 期间起点：模型参数 p_月报起始日期（date）
				    起始月份 = p_月报起始日期,
				    // 期间终点：模型参数 p_月报终止日期（手写值，跨月后需手动后移，否则取不到新月份）
				    结束月份 = p_月报终止日期,
				    // 按月递增，首尾都包含
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 转成 [ZMSDQNY] 需要的 YYYYMM 文本（年×100+月）；之后 month 一律按文本使用
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),

				    // ========== 4. 单月取数并补齐匹配键 ==========
				    // 入参 month 为 YYYYMM 文本；返回该月明细，粒度 = 公司 × 销管费分类 × 利润中心
				    查询单月 = (month as text) =>
				        let
				            // 先传期间参数，再挂度量、展开维度；顺序决定输出列，勿随意调换
				            Query = Cube.Transform(基础查询, {
				                // BW 变量 ZMSDQNY 控制截止月份，两个指标本身就是 YTD 累计值
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                {Cube.AddMeasureColumn, "累计实际", "[Measures].[4VGQHR12MHZ3FT2S9KPZM93SH]"},  // 截止当月的 YTD 实际
				                {Cube.AddMeasureColumn, "累计预算", "[Measures].[4VGQHR12MHZ3FT2S9KPZM9GFL]"},  // 截止当月的 YTD 预算
				                // 维度展开：公司名称（显示名，供报表展示）
				                {Cube.AddAndExpandDimensionColumn, "[ZBUKRS]", {"[ZBUKRS].[LEVEL01]"}, {"公司名称"}},
				                // 维度展开：销管费分类（报表行维度，按排序字段排列）
				                {Cube.AddAndExpandDimensionColumn, "[ZXGFFL]", {"[ZXGFFL].[LEVEL01]"}, {"销管费分类"}},
				                // 维度展开：管理口径利润中心
				                {Cube.AddAndExpandDimensionColumn, "[ZPRCTR_GL]", {"[ZPRCTR_GL].[LEVEL01]"}, {"管理口径利润中心"}}
				            }),
				            // 通过成员属性取回编码作为匹配键：显示名不稳定，业务板块映射必须用编码匹配
				            添加编码 = Table.AddColumn(Query, "公司代码", each Cube.AttributeMemberProperty([公司名称], "[2ZBUKRS]")),
				            // 取回销管费分类代码；仅作对照，第 7 步保留核心字段时会被裁掉
				            添加编码2 = Table.AddColumn(添加编码, "销管费分类代码", each Cube.AttributeMemberProperty([销管费分类], "[2ZXGFFL]")),
				            // 取回利润中心代码（2ZPRCTR_GL），业务板块三级匹配的主键之一
				            添加编码3 = Table.AddColumn(添加编码2, "利润中心代码", each Cube.AttributeMemberProperty([管理口径利润中心], "[2ZPRCTR_GL]")),
				            // 加载日期 = 该月 1 日（date）：month 是 YYYYMM 文本，不能直接赋给日期列，必须用 #date 单独构造
				            附加月份标记 = Table.AddColumn(添加编码3, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date)
				        in
				            附加月份标记,

				    // ========== 5. 合并各月并关联销管费分类排序 ==========
				    // 各月明细结构一致，直接纵向合并；合并后的行顺序即月份序列顺序
				    合并各月数据 = Table.Combine(List.Transform(月份文本列表, 查询单月)),
				    // 匹配键「销管费分类」，JoinKind.LeftOuter：未映射的分类保留，排序留 null；映射表已去重保证 1:1，不放大行数
				    关联分类排序 = Table.NestedJoin(合并各月数据, {"销管费分类"}, 销管费分类排序表, {"销管费分类"}, "分类映射临时", JoinKind.LeftOuter),
				    // 展开销管费分类排序，模型里供 sortByColumn 使用
				    展开分类排序 = Table.ExpandTableColumn(关联分类排序, "分类映射临时", {"销管费分类排序"}, {"销管费分类排序"}),

				    // ========== 6. 三级优先级匹配业务板块 ==========
				    // 优先级：双键 > 仅利润中心代码 > 仅公司代码。三张映射表各自已去重，三次 LeftOuter 只为挂出候选值，最后按优先级取值
				    // 第一优先级：利润中心代码 + 公司代码 双键精确匹配
				    关联1 = Table.NestedJoin(展开分类排序, {"利润中心代码", "公司代码"}, 映射_双键, {"利润中心代码", "公司代码"}, "tmp1", JoinKind.LeftOuter),
				    // 展开为临时列「业务板块_双键」，先不合并，留给最后按优先级挑选
				    展开1 = Table.ExpandTableColumn(关联1, "tmp1", {"业务板块"}, {"业务板块_双键"}),

				    // 第二优先级：仅利润中心代码（映射行中公司代码为空）
				    关联2 = Table.NestedJoin(展开1, {"利润中心代码"}, 映射_仅利润中心代码, {"利润中心代码"}, "tmp2", JoinKind.LeftOuter),
				    // 展开为临时列「业务板块_利润中心」
				    展开2 = Table.ExpandTableColumn(关联2, "tmp2", {"业务板块"}, {"业务板块_利润中心"}),

				    // 第三优先级：仅公司代码（映射行中利润中心代码为空）
				    关联3 = Table.NestedJoin(展开2, {"公司代码"}, 映射_仅公司代码, {"公司代码"}, "tmp3", JoinKind.LeftOuter),
				    // 展开为临时列「业务板块_公司」
				    展开3 = Table.ExpandTableColumn(关联3, "tmp3", {"业务板块"}, {"业务板块_公司"}),

				    // 按优先级取第一个非空值；三级全空说明映射表没覆盖该组合，统一填「待定」，让漏配在报表上一眼可见
				    填充业务板块 = Table.AddColumn(展开3, "业务板块", each
				        if [业务板块_双键] <> null then [业务板块_双键]
				        else if [业务板块_利润中心] <> null then [业务板块_利润中心]
				        else if [业务板块_公司] <> null then [业务板块_公司]
				        else "待定"),
				    // 删掉三个临时匹配列，只留最终的业务板块
				    清理临时匹配列 = Table.RemoveColumns(填充业务板块, {"业务板块_双键", "业务板块_利润中心", "业务板块_公司"}),

				    // ========== 7. 保留核心字段并生成集团合计行 ==========
				    // 只保留报表需要的 6 列；公司代码、利润中心代码、销管费分类代码等匹配用列到此为止，不再进入模型
				    保留核心字段 = Table.SelectColumns(清理临时匹配列, {"业务板块", "销管费分类排序", "加载日期", "销管费分类", "累计预算", "累计实际"}),
				    // 集团合计口径：按 销管费分类排序 + 加载日期 + 销管费分类 分组，对累计预算、累计实际跨所有业务板块求和；List.Sum 遇 null 仍为 null，保持空值语义
				    生成集团合计 = Table.Group(保留核心字段, {"销管费分类排序", "加载日期", "销管费分类"}, {
				        {"累计预算", each List.Sum([累计预算]), type nullable number},
				        {"累计实际", each List.Sum([累计实际]), type nullable number}
				    }),
				    // 给汇总结果打上 业务板块 = 集团合计
				    标记集团行 = Table.AddColumn(生成集团合计, "业务板块", each "集团合计"),
				    // 合计行在前、明细在后拼接；「集团合计」在业务板块映射表里没有对应记录，业务板块排序会留 null，最终排序位置由报表端对空值的处理决定
				    追加集团合计 = Table.Combine({标记集团行, 保留核心字段}),

				    // ========== 8. 关联业务板块排序 ==========
				    // 匹配键「业务板块」，JoinKind.LeftOuter：映射表按业务板块去重保证 1:1；「待定」「集团合计」这类虚拟值匹配不到，排序为 null
				    关联板块排序 = Table.NestedJoin(追加集团合计, {"业务板块"}, 业务板块排序表, {"业务板块"}, "板块排序临时", JoinKind.LeftOuter),
				    // 展开业务板块排序，模型里供 sortByColumn 使用
				    展开板块排序 = Table.ExpandTableColumn(关联板块排序, "板块排序临时", {"业务板块排序"}, {"业务板块排序"})
				in
				    展开板块排序

	annotation PBI_ResultType = Table

