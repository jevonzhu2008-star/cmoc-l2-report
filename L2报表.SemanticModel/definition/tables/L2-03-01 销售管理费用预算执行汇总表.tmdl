		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'L2-03-01 销售管理费用预算执行汇总表' = m
		mode: import
		queryGroup: 财经
		source =
				let
				    /*
				    【查询名称】ZRFI_CP005 销管费用 BW 取数
				    【对应报表】L2-03-01 销售管理费用预算执行汇总表
				    【BW对象】Cube:ZRFI_CP005，Query:ZRFI_CP005_Q0002
				    【说明】
				        1、循环取数：从 p_月报起始日期 到 p_月报终止日期，逐月查询 BW 后合并成长表
				        2、BW 参数 [ZMSDQNY]：YYYYMM 格式年月，返回截止当月的 YTD 累计指标
				        3、维度：公司名称（显示名称）、销管费分类、管理口径利润中心
				        4、公司代码列存放纯编码，利润中心代码列存放利润中心编码
				        5、业务板块：三级分步匹配，优先级为双键（利润中心代码 + 公司代码）> 仅利润中心代码 > 仅公司代码，三级全落空填「待定」
				        6、外部映射 Sheet「业务板块映射」表头：利润中心代码、公司代码、业务板块、业务板块排序
				        7、业务板块排序随「业务板块映射」按业务板块去重生成（同一板块只保留首条）
				        8、映射表匹配键先转文本再去重：避免 Excel 数值推断导致匹配不上、以及一键多映射导致事实行翻倍
				    */
				    // ========== 1. 读取SharePoint映射文件，一次性加载工作簿 ==========
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-03-01 销售管理费用预算执行汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    指标映射工作簿 = Excel.Workbook(指标映射文件, true),
				
				    // 读取各sheet并预处理映射表
				    销管费分类排序表 = Table.Distinct(指标映射工作簿{[Item = "销管费分类排序", Kind = "Sheet"]}[Data], {"销管费分类"}),
				    业务板块原始映射 = 指标映射工作簿{[Item = "业务板块映射", Kind = "Sheet"]}[Data],
				    业务板块排序表 = Table.Distinct(Table.SelectRows(业务板块原始映射, each [业务板块] <> null), {"业务板块"}),
				
				    // 规范化编码为文本，防止数值/文本类型不匹配
				    映射_规范化 = Table.TransformColumnTypes(业务板块原始映射, {{"利润中心代码", type text}, {"公司代码", type text}, {"业务板块", type text}}),
				    映射_双键 = Table.Distinct(Table.SelectRows(映射_规范化, each [利润中心代码] <> null and [公司代码] <> null), {"利润中心代码", "公司代码"}),
				    映射_仅利润中心代码 = Table.Distinct(Table.SelectRows(映射_规范化, each [利润中心代码] <> null and [公司代码] = null), {"利润中心代码"}),
				    映射_仅公司代码 = Table.Distinct(Table.SelectRows(映射_规范化, each [利润中心代码] = null and [公司代码] <> null), {"公司代码"}),
				
				    // ========== 2. 连接BW QAS，Cube只实例一次，避免循环重连 ==========
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [LanguageCode="ZH", Implementation="2.0", BatchSize=500000000]),
				    立方体 = 数据源{[Name="ZRFI_CP005"]}[Data],
				    基础查询 = 立方体{[Id="ZRFI_CP005/ZRFI_CP005_Q0002"]}[Data],
				
				    // ========== 3. 生成月份列表 ==========
				    起始月份 = p_月报起始日期,
				    结束月份 = p_月报终止日期,
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				
				    // ========== 4. 单月BW取数函数 ==========
				    查询单月 = (month as text) =>
				        let
				            // 传入年月参数，拉取维度+度量
				            Query = Cube.Transform(基础查询, {
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                {Cube.AddMeasureColumn, "累计实际", "[Measures].[4VGQHR12MHZ3FT2S9KPZM93SH]"},
				                {Cube.AddMeasureColumn, "累计预算", "[Measures].[4VGQHR12MHZ3FT2S9KPZM9GFL]"},
				                {Cube.AddAndExpandDimensionColumn, "[ZBUKRS]", {"[ZBUKRS].[LEVEL01]"}, {"公司名称"}},
				                {Cube.AddAndExpandDimensionColumn, "[ZXGFFL]", {"[ZXGFFL].[LEVEL01]"}, {"销管费分类"}},
				                {Cube.AddAndExpandDimensionColumn, "[ZPRCTR_GL]", {"[ZPRCTR_GL].[LEVEL01]"}, {"管理口径利润中心"}}
				            }),
				            // 提取维度属性编码
				            添加编码 = Table.AddColumn(Query, "公司代码", each Cube.AttributeMemberProperty([公司名称], "[2ZBUKRS]")),
				            添加编码2 = Table.AddColumn(添加编码, "销管费分类代码", each Cube.AttributeMemberProperty([销管费分类], "[2ZXGFFL]")),
				            添加编码3 = Table.AddColumn(添加编码2, "利润中心代码", each Cube.AttributeMemberProperty([管理口径利润中心], "[2ZPRCTR_GL]")),
				            // 标记数据归属月份（当月第一天日期）
				            附加月份标记 = Table.AddColumn(添加编码3, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date)
				        in
				            附加月份标记,
				
				    // 循环拉取所有月份并合并
				    合并各月数据 = Table.Combine(List.Transform(月份文本列表, 查询单月)),
				
				    // ========== 5. 关联销管费分类排序 ==========
				    关联分类排序 = Table.NestedJoin(合并各月数据, {"销管费分类"}, 销管费分类排序表, {"销管费分类"}, "分类映射临时", JoinKind.LeftOuter),
				    展开分类排序 = Table.ExpandTableColumn(关联分类排序, "分类映射临时", {"销管费分类排序"}, {"销管费分类排序"}),
				
				    // ========== 6. 三级优先级匹配业务板块：双键 > 利润中心 > 公司代码，落空=待定 ==========
				    关联1 = Table.NestedJoin(展开分类排序, {"利润中心代码", "公司代码"}, 映射_双键, {"利润中心代码", "公司代码"}, "tmp1", JoinKind.LeftOuter),
				    展开1 = Table.ExpandTableColumn(关联1, "tmp1", {"业务板块"}, {"业务板块_双键"}),
				
				    关联2 = Table.NestedJoin(展开1, {"利润中心代码"}, 映射_仅利润中心代码, {"利润中心代码"}, "tmp2", JoinKind.LeftOuter),
				    展开2 = Table.ExpandTableColumn(关联2, "tmp2", {"业务板块"}, {"业务板块_利润中心"}),
				
				    关联3 = Table.NestedJoin(展开2, {"公司代码"}, 映射_仅公司代码, {"公司代码"}, "tmp3", JoinKind.LeftOuter),
				    展开3 = Table.ExpandTableColumn(关联3, "tmp3", {"业务板块"}, {"业务板块_公司"}),
				
				    // 按优先级取值，清理临时匹配列
				    填充业务板块 = Table.AddColumn(展开3, "业务板块", each
				        if [业务板块_双键] <> null then [业务板块_双键]
				        else if [业务板块_利润中心] <> null then [业务板块_利润中心]
				        else if [业务板块_公司] <> null then [业务板块_公司]
				        else "待定"),
				    清理临时匹配列 = Table.RemoveColumns(填充业务板块, {"业务板块_双键", "业务板块_利润中心", "业务板块_公司"}),
				
				    // ========== 7. 筛选目标字段 + 生成集团合计行，追加回主表 ==========
				    保留核心字段 = Table.SelectColumns(清理临时匹配列, {"业务板块", "销管费分类排序", "加载日期", "销管费分类", "累计预算", "累计实际"}),
				    // 按【销管费分类排序、加载日期、销管费分类】汇总得到集团合计
				    生成集团合计 = Table.Group(保留核心字段, {"销管费分类排序", "加载日期", "销管费分类"}, {
				        {"累计预算", each List.Sum([累计预算]), type nullable number},
				        {"累计实际", each List.Sum([累计实际]), type nullable number}
				    }),
				    标记集团行 = Table.AddColumn(生成集团合计, "业务板块", each "集团合计"),
				    // 原始明细 + 合计行合并
				    追加集团合计 = Table.Combine({标记集团行, 保留核心字段}),
				
				    // ========== 8. 关联业务板块排序字段 ==========
				    关联板块排序 = Table.NestedJoin(追加集团合计, {"业务板块"}, 业务板块排序表, {"业务板块"}, "板块排序临时", JoinKind.LeftOuter),
				    展开板块排序 = Table.ExpandTableColumn(关联板块排序, "板块排序临时", {"业务板块排序"}, {"业务板块排序"})
				in
				    展开板块排序

	annotation PBI_ResultType = Table

