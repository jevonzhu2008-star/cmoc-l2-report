	partition 'L2-01-14 物料单耗月表' = m
		mode: import
		queryGroup: 财经
		source =
				let
				    /*
				    【查询名称】L2-01-14 物料单耗月表 BW 取数
				    【对应报表】L2-01-14 物料单耗月表
				    【BW对象】Cube:ZRCO_CP004，Query:ZRCO_CP004/ZRCO_CP004_Q0011
				    【说明】
				        1、数据源：SharePoint「L2-01-14 物料单耗月表指标映射」（Sheet：单位排序 / 矿体排序 / 区域排序 / 指标名称排序）+ SAP BW QAS（参数 QAS服务器 / 系统编号 / 客户端ID）
				        2、维度：[ZKT] 矿体、[ZTDISTRCT] 区域、[ZYJGX] 一级工序、[4ZRCO_CP004-ZINDITEM] 主要耗材用量、[4ZRCO_CP004-ZUNIT] 单位
				        3、指标：目标类（26年目标 / 比目标±% / 累计比目标）、当月与环比类（当月 / 当月累计 / 上月 / 环比 / 环比±% / 环比实际量LAM / 环比实际数LAM）、实际类（AM）、年累类（AY）、预算类（BM），共 16 个度量
				        4、月度循环：p_月报起始日期 ~ p_月报终止日期，逐月传 [ZMSDQNY]=YYYYMM（文本）
				        5、清洗：16 个指标列 null → 0（避免空值干扰 DIVIDE 与汇总）；加载日期 = 该月 1 日（date），供日期表关系与切片器筛选
				        6、长表化：Table.UnpivotOtherColumns 保留 区域 / 一级工序 / 主要耗材用量 / 矿体 / 单位 / 加载日期
				        7、排序：依次左连接「指标名称排序」「单位排序」「矿体排序」「区域排序」四张映射表（JoinKind.LeftOuter），带出 指标名称排序 / 单位排序 / 矿体排序 / 区域排序
				        8、该表特有逻辑：b68bb14 之后「中区东区」改名「区域」，新增「一级工序」(ZYJGX) 与「主要耗材用量」(4ZRCO_CP004-ZINDITEM)，排序 Sheet 由「中区东区排序」改为「区域排序」；当前 partition 标注 PBI_ResultType = Exception，上次刷新失败，待排查
				    */
				    // ⚠ 待核对：原注释写维度「单位、矿体、中区/东区」，代码实际为 5 个维度（矿体 / 区域 / 一级工序 / 主要耗材用量 / 单位）；「区域」即原「中区东区」，上线前确认报表侧字段引用已同步。
				    // ⚠ 已知异常：PBI_ResultType = Exception，最近一次 Desktop 刷新报错。优先排查：
				    //   (1) SharePoint 映射工作簿 Sheet 是否已从「中区东区排序」改名为「区域排序」（代码按 Sheet 名精确取）；
				    //   (2) 新维度 ZYJGX、4ZRCO_CP004-ZINDITEM 是否在 BW Query ZRCO_CP004/ZRCO_CP004_Q0011 中存在且技术名一致；
				    //   (3) 上述无误后，再关 Desktop、删 L2报表.SemanticModel/.pbi/cache.abf 重开，排除残留缓存。
				    //   以上只记录现状，不改代码。
				    // ========== 1. 读取 SharePoint 映射工作簿 ==========
				    // 连接财经 SharePoint 站点列出文件清单；ApiVersion=15 使用新版 REST 接口
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    // 仅保留文件名含「L2-01-14 物料单耗月表指标映射」且为 .xlsx 的文件，取第一个的二进制内容（[Content]）
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-01-14 物料单耗月表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    // 工作簿只解析一次，后续各 Sheet 复用同一对象，避免多次解析 xlsx 拖慢刷新
				    指标映射工作簿 = Excel.Workbook(指标映射文件, true),
				    // 四张排序映射表统一按维度键 Table.Distinct 去重：保证左连接一对一，防止同一维度匹配多行导致事实表行数翻倍
				    // Sheet「单位排序」，去重键 单位
				    单位排序映射表 = Table.Distinct(指标映射工作簿{[Item = "单位排序", Kind = "Sheet"]}[Data], {"单位"}),
				    // Sheet「矿体排序」，去重键 矿体
				    矿体排序映射表 = Table.Distinct(指标映射工作簿{[Item = "矿体排序", Kind = "Sheet"]}[Data], {"矿体"}),
				    // Sheet「区域排序」，去重键 区域（对应 BW 维度 ZTDISTRCT，原名「中区东区」；Sheet 名未改名会导致取 Sheet 失败）
				    区域排序映射表 = Table.Distinct(指标映射工作簿{[Item = "区域排序", Kind = "Sheet"]}[Data], {"区域"}),
				    // Sheet「指标名称排序」，去重键 指标名称
				    指标名称排序映射表 = Table.Distinct(指标映射工作簿{[Item = "指标名称排序", Kind = "Sheet"]}[Data], {"指标名称"}),

				    // ========== 2. 连接 BW QAS 环境 ==========
				    // 连接参数：Implementation=2.0 新版接口 / LanguageCode=ZH 返回中文 / EnableStructures=true 开启内置结构 / BatchSize 放大提升批量拉取性能
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [Implementation="2.0", LanguageCode="ZH", EnableStructures=true, BatchSize=500000000]),
				    // Cube 只在循环外实例化一次，循环内仅做 Cube.Transform，避免每月重建 BW 会话
				    // 按 Cube 名称定位 ZRCO_CP004
				    立方体 = 数据源{[Name="ZRCO_CP004"]}[Data],
				    // 按 Query ID 定位 ZRCO_CP004/ZRCO_CP004_Q0011
				    基础查询 = 立方体{[Id="ZRCO_CP004/ZRCO_CP004_Q0011"]}[Data],

				    // ========== 3. 月份循环配置 ==========
				    // 循环起始月份，取自 Power BI 参数 p_月报起始日期（date 类型）
				    起始月份 = p_月报起始日期,
				    // 循环结束月份，取自 Power BI 参数 p_月报终止日期（date 类型，手写值，跨月需手动后调）
				    结束月份 = p_月报终止日期,
				    // 生成连续月份序列：从起始月份起每月 +1，直到不超过结束月份（date 列表）
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 转成 BW 要求的 YYYYMM 文本（年×100 + 月，如 2026 年 1 月 → "202601"）
				    // 注意：此后 month 一律是文本；写日期列必须用 #date(...) 重新构造，不能直接赋给日期列
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),

				    // ========== 4. 单月取数函数 ==========
				    // 入参 month 为 YYYYMM 文本；返回该月已清洗、逆透视的长表
				    查询单月 = (month as text) =>
				        // 函数体：应用 BW 变换 → 追加加载日期 → null 替换为 0 → 逆透视
				        let
				            // 对基础查询应用一组 BW 变换：设置期间参数、展开维度、挂载度量
				            Query = Cube.Transform(基础查询, {
				                // 给 BW 变量 [ZMSDQNY] 传入当前循环年月，BW 返回截止该月的累计数据
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                // ---- 维度展开 ----
				                // 矿体：ZKT 的 LEVEL01
				                {Cube.AddAndExpandDimensionColumn, "[ZKT]", {"[ZKT].[LEVEL01]"}, {"矿体"}},
				                // 区域：ZTDISTRCT 的 LEVEL01（即原「中区东区」，报表字段已改名）
				                {Cube.AddAndExpandDimensionColumn, "[ZTDISTRCT]", {"[ZTDISTRCT].[LEVEL01]"}, {"区域"}},
				                // 一级工序：ZYJGX 的 LEVEL01（b68bb14 新增）
				                {Cube.AddAndExpandDimensionColumn, "[ZYJGX]", {"[ZYJGX].[LEVEL01]"}, {"一级工序"}},
				                // 主要耗材用量：4ZRCO_CP004-ZINDITEM 的 LEVEL01（b68bb14 新增）
				                {Cube.AddAndExpandDimensionColumn, "[4ZRCO_CP004-ZINDITEM]", {"[4ZRCO_CP004-ZINDITEM].[LEVEL01]"}, {"主要耗材用量"}},
				                // 单位：4ZRCO_CP004-ZUNIT 的 LEVEL01
				                {Cube.AddAndExpandDimensionColumn, "[4ZRCO_CP004-ZUNIT]", {"[4ZRCO_CP004-ZUNIT].[LEVEL01]"}, {"单位"}},
				                // ---- 目标类：年度目标与比目标偏差 ----
				                {Cube.AddMeasureColumn, "26年目标", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0RGAVD1MOPL]"},
				                {Cube.AddMeasureColumn, "比目标±%", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0RGAVD1N7O9]"},
				                {Cube.AddMeasureColumn, "累计比目标", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0RGAVD1N1CP]"},
				                // ---- 当月 / 上月 / 环比类 ----
				                {Cube.AddMeasureColumn, "当月", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0RGAVD1M5QX]"},
				                {Cube.AddMeasureColumn, "当月累计", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0RGAVD1MV15]"},
				                {Cube.AddMeasureColumn, "上月", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0RGAVD1LZFD]"},
				                {Cube.AddMeasureColumn, "环比", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0RGAVD1MC2H]"},
				                {Cube.AddMeasureColumn, "环比±%", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0RGAVD1MIE1]"},
				                {Cube.AddMeasureColumn, "环比实际量LAM", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0QD0454FQDC]"},
				                {Cube.AddMeasureColumn, "环比实际数LAM", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0QD0454FK1S]"},
				                // ---- 实际类：AM = 当月实际 ----
				                {Cube.AddMeasureColumn, "实际量AM", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0QD0454FDQ8]"},
				                {Cube.AddMeasureColumn, "实际数AM", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0QD0454F7EO]"},
				                // ---- 年累类：AY = 年度累计实际 ----
				                {Cube.AddMeasureColumn, "年累实际量AY", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0QD0454G30G]"},
				                {Cube.AddMeasureColumn, "年累实际数AY", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0QD0454FWOW]"},
				                // ---- 预算类：BM = 当月预算 ----
				                {Cube.AddMeasureColumn, "预算量BM", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0QD0454GFNK]"},
				                {Cube.AddMeasureColumn, "预算数BM", "[4VGQHR12MHZ1PH0QD0454F134].[4VGQHR12MHZ1PH0QD0454G9C0]"}
				            }),
				            // 追加「加载日期」：用 #date(年, 月, 1) 把 YYYYMM 文本转为当月 1 日 date（不能直接把 month 赋给日期列）
				            附加月份 = Table.AddColumn(Query, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date),
				            // null → 0：16 个指标列全部替换；列清单必须与上方 16 个 AddMeasureColumn 一致，增减度量时同步修改
				            空值替换 = Table.ReplaceValue(附加月份, null, 0, Replacer.ReplaceValue,
				                {"26年目标", "比目标±%", "当月", "当月累计", "环比", "环比±%",
				                "环比实际量LAM", "环比实际数LAM", "累计比目标", "年累实际量AY", "年累实际数AY",
				                "上月", "实际量AM", "实际数AM", "预算量BM", "预算数BM"}
				            ),
				            // 逆透视：保留 区域 / 一级工序 / 主要耗材用量 / 矿体 / 单位 / 加载日期，其余 16 个度量列转为「指标名称 / 指标值」长表
				            逆透视 = Table.UnpivotOtherColumns(空值替换, {"区域","一级工序","主要耗材用量", "矿体", "单位", "加载日期"}, "指标名称", "指标值")
				        in
				            逆透视,

				    // ========== 5. 循环取数并合并各月 ==========
				    // 对每个 YYYYMM 调用查询单月，得到 N 个月的结果表
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    // 纵向合并各月结果为一张长表
				    合并结果 = Table.Combine(各月结果),

				    // ========== 6. 左连接「指标名称排序」映射表 ==========
				    // 匹配键 指标名称，JoinKind.LeftOuter 保留全部事实行；右侧已 Table.Distinct 去重，保证一对一
				    左连接指标排序 = Table.NestedJoin(合并结果, {"指标名称"}, 指标名称排序映射表, {"指标名称"}, "映射指标", JoinKind.LeftOuter),
				    // 展开映射列，只带出「指标名称排序」，供模型 sortByColumn 使用
				    展开指标排序 = Table.ExpandTableColumn(左连接指标排序, "映射指标", {"指标名称排序"}, {"指标名称排序"}),

				    // ========== 7. 左连接「单位排序」映射表 ==========
				    // 匹配键 单位，JoinKind.LeftOuter 保留未匹配单位；右侧按单位去重避免行数膨胀
				    左连接单位排序 = Table.NestedJoin(展开指标排序, {"单位"}, 单位排序映射表, {"单位"}, "映射单位", JoinKind.LeftOuter),
				    // 展开映射列，只带出「单位排序」
				    展开单位排序 = Table.ExpandTableColumn(左连接单位排序, "映射单位", {"单位排序"}, {"单位排序"}),

				    // ========== 8. 左连接「矿体排序」映射表 ==========
				    // 匹配键 矿体，JoinKind.LeftOuter 保留未匹配矿体；右侧按矿体去重避免行数膨胀
				    左连接矿体排序 = Table.NestedJoin(展开单位排序, {"矿体"}, 矿体排序映射表, {"矿体"}, "映射矿体", JoinKind.LeftOuter),
				    // 展开映射列，只带出「矿体排序」
				    展开矿体排序 = Table.ExpandTableColumn(左连接矿体排序, "映射矿体", {"矿体排序"}, {"矿体排序"}),

				    // ========== 9. 左连接「区域排序」映射表 ==========
				    // 匹配键 区域，JoinKind.LeftOuter 保留未匹配区域；右侧按区域去重避免行数膨胀
				    左连接区域排序 = Table.NestedJoin(展开矿体排序, {"区域"}, 区域排序映射表, {"区域"}, "映射区域", JoinKind.LeftOuter),
				    // 展开映射列，只带出「区域排序」
				    展开区域排序 = Table.ExpandTableColumn(左连接区域排序, "映射区域", {"区域排序"}, {"区域排序"})
				in
				    展开区域排序

	annotation PBI_ResultType = Exception

