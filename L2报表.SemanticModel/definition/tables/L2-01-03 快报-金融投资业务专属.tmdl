	column 指标值
		dataType: double
		lineageTag: 96dc77ea-ca8c-4f0d-b952-7c4b7cf45396
		summarizeBy: sum
		sourceColumn: 指标值

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'L2-01-03 快报-金融投资业务专属' = m
		mode: import
		queryGroup: 财经\多月
		source = ```
				let
				    /*
				    【查询名称】ZRFI_CP012 金融投资业务专属 BW取数
				    【对应报表】L2‑01‑03 快报-金融投资业务专属
				    【BW对象】Cube:ZRFI_CP012   Query:ZRFI_CP012_Q0001
				    【说明】
				        1、循环取数：从参数 p_月报起始日期 到 p_月报终止日期，逐月查询BW后合并
				        2、BW参数[ZMSDQNY]：YYYYMM格式，BW根据该参数返回截止该月的YTD数据
				        3、维度：公司代码、金融投资产品、公司代码货币
				        4、指标：年净值、投资变动、本年利润累计、上月累计、当月数、期末净值、汇率变动共17个Measure
				        5、末尾逆透视：把17个指标列转成「指标名称+指标值」的长表结构，方便报表按指标筛选展示
				    */
				    
				    // ========== 第一步：连接BW QAS环境 ==========
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [Implementation="2.0"]),
				    
				    // ========== 第二步：定位Cube与目标BW查询 ==========
				    立方体 = 数据源{[Name="ZRFI_CP012"]}[Data],
				    基础查询 = 立方体{[Id="ZRFI_CP012/ZRFI_CP012_Q0001"]}[Data],
				    
				    // ========== 第三步：月份循环配置 ==========
				    // 月报起始月份，取自PowerBI参数 p_月报起始日期
				    起始月份 = p_月报起始日期,
				    // 月报结束月份，取自PowerBI参数 p_月报终止日期
				    结束月份 = p_月报终止日期,
				    // 生成连续月份序列（从起始到结束，逐月+1）
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 转换为BW要求的 YYYYMM 文本格式（如202601）
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				    
				    // ========== 第四步：单月取数函数 ==========
				    // 输入：年月文本（如"202603"），输出：该月的BW查询结果表
				    查询单月 = (month as text) =>
				        let
				            // Measure公共前缀，避免重复写
				            MeasurePrefix = "[Measures].[4VGQHR12MHZ3FUPQLKJ2",
				            
				            // 执行BW查询，添加所有指标列和维度展开
				            Query = Cube.Transform(基础查询, {
				                // 设置期间参数：当前循环到的月份
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                
				                // ===== 年净值类指标（期初/年累计） =====
				                {Cube.AddMeasureColumn, "年净值-成本", MeasurePrefix & "R9KUV]"},
				                {Cube.AddMeasureColumn, "年净值-公允价值变动", MeasurePrefix & "R9R6F]"},
				                {Cube.AddMeasureColumn, "年净值-合计", MeasurePrefix & "R9XHZ]"},
				                
				                // ===== 投资变动类指标 =====
				                {Cube.AddMeasureColumn, "本年-新增投资", MeasurePrefix & "RA3TJ]"},
				                
				                // ===== 本年利润类指标（累计发生数） =====
				                {Cube.AddMeasureColumn, "本年利润-累计公允价值变动", MeasurePrefix & "RAA53]"},
				                {Cube.AddMeasureColumn, "本年利润-累计投资收益", MeasurePrefix & "RAGGN]"},
				                {Cube.AddMeasureColumn, "本年利润-累计所得税费用影响", MeasurePrefix & "RAMS7]"},
				                {Cube.AddMeasureColumn, "本年利润-退出成本", MeasurePrefix & "RAT3R]"},
				                {Cube.AddMeasureColumn, "本年利润-退出持有收益", MeasurePrefix & "RAZFB]"},
				                
				                // ===== 上月累计数（用于环比计算） =====
				                {Cube.AddMeasureColumn, "本年利润-累计公允价值变动(上月累计)", MeasurePrefix & "RB5QV]"},
				                {Cube.AddMeasureColumn, "本年利润-累计投资收益(上月累计)", MeasurePrefix & "RBC2F]"},
				                {Cube.AddMeasureColumn, "本年利润-累计所得税费用影响(上月累计)", MeasurePrefix & "RBIDZ]"},
				                
				                // ===== 当月发生数 =====
				                {Cube.AddMeasureColumn, "本年利润-当月数", MeasurePrefix & "RBOPJ]"},
				                
				                // ===== 期末净值类指标 =====
				                {Cube.AddMeasureColumn, "期末净值-成本", MeasurePrefix & "RBV13]"},
				                {Cube.AddMeasureColumn, "期末净值-公允价值变动", MeasurePrefix & "RC1CN]"},
				                {Cube.AddMeasureColumn, "期末净值-合计", MeasurePrefix & "RC7O7]"},
				                
				                // ===== 汇率影响类指标 =====
				                {Cube.AddMeasureColumn, "当月汇率变动影响-币种（CNY)", MeasurePrefix & "RCDZR]"},
				                
				                // ===== 维度展开（取Level 01层级） =====
				                {Cube.AddAndExpandDimensionColumn, "[ZBUKRS]", {"[ZBUKRS].[LEVEL01]"}, {"公司代码"}},
				                {Cube.AddAndExpandDimensionColumn, "[4ZRFI_CP012-RHCUR]", {"[4ZRFI_CP012-RHCUR].[LEVEL01]"}, {"公司代码货币"}},
				                {Cube.AddAndExpandDimensionColumn, "[4ZRFI_CP012-CC_A_JRTZCP]", {"[4ZRFI_CP012-CC_A_JRTZCP].[LEVEL01]"}, {"金融投资产品"}}
				            }),
				            
				            // 附加「加载年月」字段，标记本条数据对应的查询期间
				            附加加载年月 = Table.AddColumn(Query, "加载年月", each month, type text)
				        in
				            附加加载年月,
				    
				    // ========== 第五步：循环遍历月份，逐个执行取数 ==========
				    // 得到一个列表，每个元素是一个月份的表
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    
				    // ========== 第六步：合并所有月份的表 ==========
				    // 把N个月的表上下合并成一张大表
				    合并结果 = Table.Combine(各月结果),
				    
				    // ========== 第七步：逆透视（宽表转长表） ==========
				    // 原来17个指标是17列（宽表），逆透视后变成2列：「指标名称」+「指标值」
				    // 保留不动的列：维度字段 + 加载年月
				    // 被逆透视的列：所有17个Measure列
				    已逆透视其他列 = Table.UnpivotOtherColumns(
				        合并结果, 
				        {"公司代码", "公司代码货币", "金融投资产品", "加载年月"},  // 保留的列
				        "指标名称",   // 新列名：存指标名称（如"年净值-成本"）
				        "指标值"      // 新列名：存指标数值
				    )
				in
				    已逆透视其他列
				```

	annotation PBI_ResultType = Table

