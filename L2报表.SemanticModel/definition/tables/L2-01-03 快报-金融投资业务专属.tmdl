	column '公司代码货币 级别 01'
		dataType: string
		isHidden
		lineageTag: 98e02fd4-a5ec-4e28-9469-71fc97c9a6f5
		summarizeBy: none
		sourceColumn: 公司代码货币 级别 01

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition 'L2-01-03 快报-金融投资业务专属' = m
		mode: import
		queryGroup: 财经
		source =
				let
				    /*
				    【查询名称】ZRFI_CP012 金融投资业务专属 BW 取数
				    【对应报表】L2-01-03 快报-金融投资业务专属
				    【BW对象】Cube:ZRFI_CP012，Query:ZRFI_CP012_Q0001
				    【说明】
				        1、数据源：SharePoint「L2-01-03 快报-金融投资业务专属指标映射.xlsx」的「指标排序」「金融投资产品排序」「公司代码排序」三张工作表 + SAP BW QAS（参数 QAS服务器 / 系统编号 / 客户端ID）
				        2、BW 对象：Cube ZRFI_CP012 → Query ZRFI_CP012/ZRFI_CP012_Q0001；本表不使用内置结构，连接未开启 EnableStructures
				        3、维度：公司代码（ZBUKRS）、公司代码货币（0LOC_CURRCY 的 LEVEL01，再取属性 20LOC_CURRCY 派生 [公司代码货币]）、金融投资产品（4ZRFI_CP012-CC_A_JRTZCP 的 LEVEL01）
				        4、指标：年净值、投资变动、本年利润累计（含上月累计与退出类）、当月发生数、期末净值、汇率变动影响，共 17 个 Measure
				        5、月度循环：p_月报起始日期 ~ p_月报终止日期 逐月查询后纵向合并；[ZMSDQNY] 必须传 YYYYMM 文本，BW 据此返回截止该月的累计口径
				        6、清洗与长表化：未做 null → 0 替换，BW 空值原样保留；17 个指标列逆透视成 [指标名称] / [指标值]，保留 3 个业务维度、中间层级列 [公司代码货币 级别 01] 与 加载日期（date 类型，取该月 1 日）
				        7、排序映射：依次左连接「指标排序」「金融投资产品排序」「公司代码排序」三张映射表，带出 [指标排序] / [金融投资产品排序] / [公司代码排序]；每张表先按匹配键去重，避免一对多放大行数
				        8、特有逻辑：17 个 Measure 的 unique name 共用一个前缀，用 MeasurePrefix 拼接；[公司代码货币] 由前一列 [公司代码货币 级别 01] 派生，两个变换的先后顺序不能调换
				    */
				    // ========== 1. 读取 SharePoint 映射工作簿 ==========
				    // 连接财经 SharePoint 站点；ApiVersion=15 为新版 REST 接口，返回的是文件列表（不是工作簿内容）
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    // 按文件名含「L2-01-03 快报-金融投资业务专属指标映射」且扩展名 .xlsx 筛出，{0}[Content] 直接取第一条的二进制内容——站点上若有多份同名映射或文件缺失，这里会取错 / 报错
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-01-03 快报-金融投资业务专属指标映射") and [Extension] = ".xlsx"){0}[Content],
				    // 工作簿只解析一次，后续各 Sheet 复用该结果（同一 xlsx 反复解析会明显拖慢刷新）
				    指标映射工作簿 = Excel.Workbook(指标映射文件, true),
				    // 指标排序表：按 指标名称 去重，保证左连接时每个指标只有一行
				    指标排序表 = Table.Distinct(指标映射工作簿{[Item = "指标排序", Kind = "Sheet"]}[Data], {"指标名称"}),
				    // 金融投资产品排序表：按 金融投资产品 去重，保证左连接时每个产品只有一行
				    金融投资产品排序表 = Table.Distinct(指标映射工作簿{[Item = "金融投资产品排序", Kind = "Sheet"]}[Data], {"金融投资产品"}),
				    // 公司代码排序表：按 公司代码 去重，保证左连接时每个公司代码只有一行
				    公司代码排序表 = Table.Distinct(指标映射工作簿{[Item = "公司代码排序", Kind = "Sheet"]}[Data], {"公司代码"}),
				    // ========== 2. 连接 BW QAS 环境 ==========
				    // 连接 BW QAS 环境：Implementation=2.0 用新版接口 / LanguageCode=ZH 返回中文；本表不用内置结构，故未开 EnableStructures
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [Implementation="2.0", LanguageCode="ZH"]),
				    // 按 Cube 名称定位 ZRFI_CP012；Cube 只在这里实例化一次，月份循环里只做 Cube.Transform，不重复连 BW
				    立方体 = 数据源{[Name="ZRFI_CP012"]}[Data],
				    // 按 Query ID 定位 ZRFI_CP012/ZRFI_CP012_Q0001，作为逐月变换的基础查询
				    基础查询 = 立方体{[Id="ZRFI_CP012/ZRFI_CP012_Q0001"]}[Data],
				    // ========== 3. 月份循环配置 ==========
				    // 循环起始月份，取自 Power BI 参数 p_月报起始日期（date 类型）
				    起始月份 = p_月报起始日期,
				    // 循环结束月份，取自 Power BI 参数 p_月报终止日期（date 类型，手写值，跨月后需手动后延，否则取不到新月份）
				    结束月份 = p_月报终止日期,
				    // 生成连续月份序列：从起始月份起每月 +1，直到不超过结束月份（date 列表）
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 转成 BW 要求的 YYYYMM 文本（年×100+月，如 2026-03 → "202603"）；month 全程是文本，不能当日期用，加载日期必须另行 #date 构造
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				    // ========== 4. 单月取数函数 ==========
				    // 输入 YYYYMM 文本，返回该月 BW 明细：已展开 3 个维度，并补上 [加载日期]
				    查询单月 = (month as text) =>
				        let
				            // 17 个 Measure 的 unique name 只有后缀不同，先抽出公共前缀，下面各列只写后缀
				            MeasurePrefix = "[Measures].[4VGQHR12MHZ3FUPQLKJ2",
				            // 对基础查询应用一组 BW 变换：设置期间参数、添加 17 个度量列、展开维度
				            Query = Cube.Transform(基础查询, {
				                // 设置 BW 期间参数 [ZMSDQNY] = 当前循环月份
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                // ========== 年净值类指标（期初 / 年累计） ==========
				                {Cube.AddMeasureColumn, "年净值-成本", MeasurePrefix & "R9KUV]"},
				                {Cube.AddMeasureColumn, "年净值-公允价值变动", MeasurePrefix & "R9R6F]"},
				                {Cube.AddMeasureColumn, "年净值-合计", MeasurePrefix & "R9XHZ]"},
				                // ========== 投资变动类指标 ==========
				                {Cube.AddMeasureColumn, "本年-新增投资", MeasurePrefix & "RA3TJ]"},
				                // ========== 本年利润类指标（累计发生数） ==========
				                {Cube.AddMeasureColumn, "本年利润-累计公允价值变动", MeasurePrefix & "RAA53]"},
				                {Cube.AddMeasureColumn, "本年利润-累计投资收益", MeasurePrefix & "RAGGN]"},
				                {Cube.AddMeasureColumn, "本年利润-累计所得税费用影响", MeasurePrefix & "RAMS7]"},
				                {Cube.AddMeasureColumn, "本年利润-退出成本", MeasurePrefix & "RAT3R]"},
				                {Cube.AddMeasureColumn, "本年利润-退出持有收益", MeasurePrefix & "RAZFB]"},
				                // ========== 上月累计数（用于环比计算） ==========
				                {Cube.AddMeasureColumn, "本年利润-累计公允价值变动(上月累计)", MeasurePrefix & "RB5QV]"},
				                {Cube.AddMeasureColumn, "本年利润-累计投资收益(上月累计)", MeasurePrefix & "RBC2F]"},
				                {Cube.AddMeasureColumn, "本年利润-累计所得税费用影响(上月累计)", MeasurePrefix & "RBIDZ]"},
				                // ========== 当月发生数 ==========
				                {Cube.AddMeasureColumn, "本年利润-当月数", MeasurePrefix & "RBOPJ]"},
				                // ========== 期末净值类指标 ==========
				                {Cube.AddMeasureColumn, "期末净值-成本", MeasurePrefix & "RBV13]"},
				                {Cube.AddMeasureColumn, "期末净值-公允价值变动", MeasurePrefix & "RC1CN]"},
				                {Cube.AddMeasureColumn, "期末净值-合计", MeasurePrefix & "RC7O7]"},
				                // ========== 汇率影响类指标 ==========
				                {Cube.AddMeasureColumn, "当月汇率变动影响-币种（CNY)", MeasurePrefix & "RCDZR]"},
				                // ========== 维度展开：公司代码 / 公司代码货币 / 金融投资产品（均取 LEVEL01） ==========
				                {Cube.AddAndExpandDimensionColumn, "[ZBUKRS]", {"[ZBUKRS].[LEVEL01]"}, {"公司代码"}},
				                {Cube.AddAndExpandDimensionColumn, "[0LOC_CURRCY]", {"[0LOC_CURRCY].[LEVEL01]"}, {"公司代码货币 级别 01"}},
				                // 由 [公司代码货币 级别 01] 的 20LOC_CURRCY 属性派生业务字段 [公司代码货币]；依赖上一行已展开的 级别 01 列，顺序不能调换
				                {Table.AddColumn, "公司代码货币", each Cube.AttributeMemberProperty([公司代码货币 级别 01], "[20LOC_CURRCY]")},
				                {Cube.AddAndExpandDimensionColumn, "[4ZRFI_CP012-CC_A_JRTZCP]", {"[4ZRFI_CP012-CC_A_JRTZCP].[LEVEL01]"}, {"金融投资产品"}}
				            }),
				            // 加载日期：把循环变量 month（YYYYMM 文本）换算成该月 1 日的 date；⚠ month 是文本不能直接赋给 date 列，必须用 #date(年, 月, 1) 重新构造
				            附加加载日期 = Table.AddColumn(Query, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date)
				        in
				            附加加载日期,
				    // ========== 5. 循环遍历月份，逐个取数 ==========
				    // 逐月调用单月函数：每月一次 BW 往返，月份数直接决定刷新耗时，是该取数模式的主要成本
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    // ========== 6. 合并所有月份的结果 ==========
				    // 把 N 个月的结果表上下合并成一张长表
				    合并结果 = Table.Combine(各月结果),
				    // ========== 7. 逆透视（宽表转长表） ==========
				    // 17 个 Measure 在宽表里是 17 列，逆透视后变成 [指标名称] / [指标值] 两列；BW 空值未做 null → 0 替换，[指标值] 里可能留 null
				    // 保留列：公司代码、公司代码货币、公司代码货币 级别 01（中间层级列，模型里隐藏）、金融投资产品、加载日期
				    // 除上述保留列外的 17 个指标列全部被逆透视
				    逆透视长表 = Table.UnpivotOtherColumns(
				        合并结果,
				        {"公司代码", "公司代码货币", "公司代码货币 级别 01", "金融投资产品", "加载日期"}, // 保留列：维度 + 中间层级列 + 加载日期
				        "指标名称", // 第 3 参数是新列名，存指标名称（如 "年净值-成本"）
				        "指标值" // 第 4 参数是新列名，存指标值
				    ),
				    // ========== 8. 左连接「指标排序」映射表 ==========
				    // 按 指标名称 匹配；JoinKind.LeftOuter 保留未匹配行；指标排序表已按 指标名称 去重，不会一对多放大行数
				    左连接指标排序 = Table.NestedJoin(逆透视长表, {"指标名称"}, 指标排序表, {"指标名称"}, "指标映射临时", JoinKind.LeftOuter),
				    // 只展开 [指标排序] 一个字段
				    展开指标排序 = Table.ExpandTableColumn(左连接指标排序, "指标映射临时", {"指标排序"}, {"指标排序"}),
				    // ========== 9. 左连接「金融投资产品排序」映射表 ==========
				    // 按 金融投资产品 匹配；JoinKind.LeftOuter 保留未匹配行；映射表已按 金融投资产品 去重，不会一对多放大行数
				    左连接产品排序 = Table.NestedJoin(展开指标排序, {"金融投资产品"}, 金融投资产品排序表, {"金融投资产品"}, "产品映射临时", JoinKind.LeftOuter),
				    // 只展开 [金融投资产品排序] 一个字段
				    展开产品排序 = Table.ExpandTableColumn(左连接产品排序, "产品映射临时", {"金融投资产品排序"}, {"金融投资产品排序"}),
				    // ========== 10. 左连接「公司代码排序」映射表 ==========
				    // 按 公司代码 匹配；JoinKind.LeftOuter 保留未匹配行；映射表已按 公司代码 去重，不会一对多放大行数
				    左连接公司排序 = Table.NestedJoin(展开产品排序, {"公司代码"}, 公司代码排序表, {"公司代码"}, "公司映射临时", JoinKind.LeftOuter),
				    // 只展开 [公司代码排序] 一个字段
				    展开公司排序 = Table.ExpandTableColumn(左连接公司排序, "公司映射临时", {"公司代码排序"}, {"公司代码排序"})
				in
				    展开公司排序

	annotation PBI_ResultType = Table

