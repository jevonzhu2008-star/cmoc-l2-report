table 'L2-01-03 快报-金融投资业务专属'
	lineageTag: 94fa0046-8d8d-4546-97d7-bf5bc2710f8a

	column 公司代码
		dataType: string
		lineageTag: aa6a8c1d-f5c7-442f-a5b8-c5a61e0d6a26
		summarizeBy: none
		sourceColumn: 公司代码

		annotation SummarizationSetBy = Automatic

	column 公司代码货币
		dataType: string
		lineageTag: d0b0c8f4-12ae-4b4c-bf30-f858f68915cb
		summarizeBy: none
		sourceColumn: 公司代码货币

		annotation SummarizationSetBy = Automatic

	column 金融投资产品
		dataType: string
		lineageTag: c161ac73-f1e8-49bd-b6f6-1414631711a9
		summarizeBy: none
		sourceColumn: 金融投资产品

		annotation SummarizationSetBy = Automatic

	column 加载年月
		dataType: string
		lineageTag: f56d50f9-5a7f-4e9c-8e80-a5b90d3ffb31
		summarizeBy: none
		sourceColumn: 加载年月

