	partition 'L2-01-03 快报-金融投资业务专属' = m
		mode: import
		queryGroup: 财经\单月
		source =
				let
				    /*
				    【查询名称】ZRFI_CP012 快报-金融投资业务专属 BW取数
				    【对应报表】L2-01-03 快报-金融投资业务专属
				    【BW对象】Cube:ZRFI_CP012   Query:ZRFI_CP012_Q0001
				    【说明】
				        1、该BW Query启用Structure，返回金融投资业务：净值、利润、新增投资等指标
				        2、BW参数[ZMSDQNY]：YYYYMM格式年月，当前硬编码202601，后续业务口径确认后改为循环动态年月
				        3、连接参数统一：QAS服务器、系统编号、客户端ID，和项目内其他BW查询保持一套参数规范
				        4、维度：公司代码 [ZBUKRS]，输出列【公司代码 级别 01】
				        5、指标分组：年净值、本年新增投资、本年利润（YTD/上月累计/当月）、期末净值、汇率变动影响
				    */
				    // ========= BW原生取数逻辑 =========
				    // 1、连接BW QAS环境
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [Implementation="2.0", LanguageCode="ZH", EnableStructures=true, BatchSize=500000000]),
				    // 2、定位Cube与目标BW查询
				    立方体 = 数据源{[Name="ZRFI_CP012"]}[Data],
				    基础查询 = 立方体{[Id="ZRFI_CP012/ZRFI_CP012_Q0001"]}[Data],
				    // 3、BW查询转换：传入期间参数、展开维度、批量拉取度量指标
				    BW查询转换 = Cube.Transform(基础查询, {{Cube.ApplyParameter, "[ZMSDQNY]", {"202601"}}, {Cube.AddMeasureColumn, "年净值-成本", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2R9KUV]"}, {Cube.AddMeasureColumn, "年净值-公允价值变动", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2R9R6F]"}, {Cube.AddMeasureColumn, "年净值-合计", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2R9XHZ]"}, {Cube.AddMeasureColumn, "本年-新增投资", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RA3TJ]"}, {Cube.AddMeasureColumn, "本年利润-累计公允价值变动", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RAA53]"}, {Cube.AddMeasureColumn, "本年利润-累计投资收益", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RAGGN]"}, {Cube.AddMeasureColumn, "本年利润-累计所得税费用影响", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RAMS7]"}, {Cube.AddMeasureColumn, "本年利润-退出成本", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RAT3R]"}, {Cube.AddMeasureColumn, "本年利润-退出持有收益", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RAZFB]"}, {Cube.AddMeasureColumn, "本年利润-累计公允价值变动(上月累计)", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RB5QV]"}, {Cube.AddMeasureColumn, "本年利润-累计投资收益(上月累计)", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RBC2F]"}, {Cube.AddMeasureColumn, "本年利润-累计所得税费用影响(上月累计)", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RBIDZ]"}, {Cube.AddMeasureColumn, "本年利润-当月数", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RBOPJ]"}, {Cube.AddMeasureColumn, "期末净值-成本", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RBV13]"}, {Cube.AddMeasureColumn, "期末净值-公允价值变动", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RC1CN]"}, {Cube.AddMeasureColumn, "期末净值-合计", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RC7O7]"}, {Cube.AddMeasureColumn, "当月汇率变动影响-币种（CNY)", "[4VGQHR12MHZ3FUPQLKJ2R7TNB].[4VGQHR12MHZ3FUPQLKJ2RCDZR]"}, {Cube.AddAndExpandDimensionColumn, "[ZBUKRS]", {"[ZBUKRS].[LEVEL01]"}, {"公司代码"}}})
				in
				    BW查询转换

	annotation PBI_ResultType = Table

