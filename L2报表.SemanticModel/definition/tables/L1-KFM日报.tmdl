	partition L1-KFM日报 = m
		mode: import
		queryGroup: 成本
		source =
				let
				    数据源 = SapBusinessWarehouse.Cubes(服务器, 系统编号, 客户端ID, [LanguageCode="ZH", Implementation="2.0", BatchSize=500000000]),
				    立方体 = 数据源{[Name="ZRPP_CP006"]}[Data],
				    基础查询 = 立方体{[Id="ZRPP_CP006/ZRPP_CP006_Q0001"]}[Data],
				    // 按月循环取数：从 p_日报起始日期 到当年 12 月，逐月查询 SAP BW 后合并
				    合并月度数据 = let
				        起始日期 = p_日报起始日期,
				        结束日期 = #date(Date.Year(DateTimeZone.SwitchZone(DateTimeZone.UtcNow(), 8)), 12, 1),
				        月份列表 = List.Generate(() => 起始日期, each _ <= 结束日期, each Date.AddMonths(_, 1)),
				        月份编码列表 = List.Transform(月份列表, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				        查询单月 = (month as text) =>
				            let
				                Query = Cube.Transform(基础查询, {
				                    {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZCPL]", {"[4ZRPP_CP006-ZCPL].[LEVEL01]"}, {"产品分类"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZCX]", {"[4ZRPP_CP006-ZCX].[LEVEL01]"}, {"产线"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZUNIT]", {"[4ZRPP_CP006-ZUNIT].[LEVEL01]"}, {"单位"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZHJ]", {"[4ZRPP_CP006-ZHJ].[LEVEL01]"}, {"指标类型"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZDATE]", {"[4ZRPP_CP006-ZDATE].[LEVEL01]"}, {"日期"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZSJGX_T]", {"[4ZRPP_CP006-ZSJGX_T].[LEVEL01]"}, {"工序"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZYYXS]", {"[4ZRPP_CP006-ZYYXS].[LEVEL01]"}, {"运营形式"}},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZINDID]", {"[4ZRPP_CP006-ZINDID].[LEVEL01]"}, {"指标编码"}},
				                    {Table.AddColumn, "指标编码代码", each Cube.AttributeMemberProperty([指标编码], "[24ZRPP_CP006-ZINDID]")},
				                    {Cube.AddAndExpandDimensionColumn, "[4ZRPP_CP006-ZINDITEM]", {"[4ZRPP_CP006-ZINDITEM].[LEVEL01]"}, {"指标名称"}},
				                    {Cube.AddMeasureColumn, "当日实际数", "[Measures].[ZRPP_CP006_CKF_001]"},
				                    {Cube.AddMeasureColumn, "当月累计实际数", "[Measures].[ZRPP_CP006_CKF_002]"},
				                    {Cube.AddMeasureColumn, "月计划", "[Measures].[ZRPP_CP006_CKF_004]"},
				                    {Cube.AddMeasureColumn, "月预算", "[Measures].[ZRPP_CP006_CKF_007]"}
				                }),
				                附加月份 = Table.AddColumn(Query, "日期（月份）", each month)
				            in
				                附加月份,
				        各月结果 = List.Transform(月份编码列表, 查询单月),
				        合并结果 = Table.Combine(各月结果)
				    in
				        合并结果,
				    // 按指标名称 + 产品分类/工序 映射出报表使用的「指标名」
				    映射指标名 = Table.AddColumn(合并月度数据, "指标名", each
				        if [指标名称] = "采矿量" then "采矿量"
				        else if [指标名称] = "剥离量" then "剥离量"
				        else if [指标名称] = "采剥总量" then "采剥总量"
				        else if [指标名称] = "剥采比" then "平均剥采比"
				        else if [指标名称] = "出矿品位" and Text.Upper([产品分类]) = "全钴TCO" then "出矿品位TCo"
				        else if [指标名称] = "出矿品位" and Text.Upper([产品分类]) = "全铜TCU" then "出矿品位TCu"
				        else if [工序] = "磨矿" and [指标名称] = "原矿处理量" then "原矿处理量"
				        else if [指标名称] = "入选品位" and Text.Upper([产品分类]) = "全铜TCU" then "入选品位-全铜"
				        else if [指标名称] = "入选品位" and Text.Upper([产品分类]) = "全钴TCO" then "入选品位-全钴"
				        else if [工序] = "磨矿" and [指标名称] = "设备运转率" then "设备运转率"
				        else if [工序] = "磨矿" and [指标名称] = "台时处理量" then "台时处理量"
				        else if [指标名称] = "选冶(理论)回收率" and Text.Upper([产品分类]) = "全铜TCU" then "选冶(理论)回收率-铜"
				        else if [指标名称] = "选冶(理论)回收率" and Text.Upper([产品分类]) = "全钴TCO" then "选冶(理论)回收率-钴"
				        else if [工序] = "搅拌浸出" and [指标名称] = "吨铜酸耗" then "吨铜酸耗"
				        else if [工序] = "产品" and [指标名称] = "矿产品产量(金属量)" and Text.Upper([产品分类]) = "全铜TCU" then "产量-阴极铜"
				        else if [工序] = "产品" and [指标名称] = "矿产品产量(金属量)" and Text.Upper([产品分类]) = "全钴TCO" then "产量-氢氧化钴"
				        else ""
				    ),
				    // 左连接日报指标映射，补充类别、序号、总类别、环节序号
				    合并指标映射 = Table.NestedJoin(映射指标名, {"指标名称"}, 日报指标映射, {"指标项"}, "映射数据", JoinKind.LeftOuter),
				    展开指标映射 = Table.ExpandTableColumn(合并指标映射, "映射数据", {"类别", "序号", "环节", "环节序号"}, {"类别", "序号", "总类别", "环节序号"}),
				    // 按序号 + 指标名细分「类别2」
				    添加二级指标 = Table.AddColumn(展开指标映射, "二级指标", each
				             if [序号] = 2 and [产品分类] = "全钴TCo" then "出矿品位TCo"
				        else if [序号] = 2 and [产品分类] = "全铜TCu" then "出矿品位TCu"
				        else if [序号] = 3 and [产品分类]= "全钴TCo" then "原矿钴品位TCo"
				        else if [序号] = 3 and [产品分类] = "全铜TCu" then "原矿铜品位TCu"
				        else if [序号] = 4 and [产品分类] = "全铜TCu" then "铜选冶综合回收率TCu"
				        else if [序号] = 4 and [产品分类]= "全钴TCo" then "钴选冶综合回收率TCo"
				        else if [序号] = 5 and [产品分类] = "全铜TCu" then "阴极铜产量"
				        else if [序号] = 5 and [产品分类]= "全钴TCo" then "氢氧化钴含钴产量"
				        else [类别]
				    ),
				    // 排序键 = 序号 × 10 + 铜钴次序（铜 0 钴 1）
				    添加排序键 = Table.AddColumn(添加二级指标, "排序", each
				        let
				            主序 = [序号],
				            次序 = if List.Contains({2,3,4,5}, [序号]) then
				                if [产品分类] = "全铜TCu" then 0
				                else if [产品分类] = "全钴TCo" then 1
				                else 0
				            else 0
				        in
				            主序 * 10 + 次序
				    ),
				    添加地域 = Table.AddColumn(添加排序键, "地域", each "KFM"),
				    // 保留输出列
				    保留列 = Table.SelectColumns(添加地域, {"产品分类", "产线", "单位", "指标类型", "日期", "运营形式", "指标编码", "指标编码代码", "指标名称", "当日实际数", "当月累计实际数", "月计划", "月预算", "日期（月份）", "指标名", "类别", "序号", "总类别", "环节序号", "二级指标", "排序", "地域"}),
				    // 日期派生字段
				    添加年份 = Table.AddColumn(保留列, "年", each Date.Year(Date.From([日期])), Int64.Type),
				    添加标准日期 = Table.AddColumn(添加年份, "标准日期", each try Date.FromText([日期], [Format="yyyy.MM.dd"]) otherwise null, type date),
				    添加上月编码 = Table.AddColumn(添加标准日期, "上月年月编码", each
				    let
				        日期值 = Date.From([日期]),
				        当月年 = Date.Year(日期值),
				        当月月 = Date.Month(日期值),
				        当月首日 = #date(当月年, 当月月, 1),
				        // 判断：如果是1月，则取当月首日；否则取上月首日
				        基准日期 = if 当月月 = 1 then 当月首日 else Date.AddMonths(当月首日, -1)
				    in
				        Text.From(Date.Year(基准日期)) & Text.PadStart(Text.From(Date.Month(基准日期)), 2, "0")
				, type text),
				    // 最近日期基准 = 「原矿处理量」指标的最大标准日期（用于标记「最近日期」）
				    最大主指标日期 = List.Max(Table.SelectRows(添加上月编码, each [指标名称] = "原矿处理量")[标准日期]),
				    // 日期筛选器：标准日期等于基准的行标记为「最近日期」，其余保留标准日期
				    添加日期筛选器 = Table.AddColumn(添加上月编码, "日期筛选器", each
				        if [标准日期] = 最大主指标日期 then "最近日期" else [标准日期]
				    ),
				    // ========================================================================
				    // 内联中间表：全年预算数（按 产品分类+年+指标项 汇总）
				    全年预算表 = Table.Group(
				        Table.AddColumn(
				            Table.SelectColumns(KFM选冶厂月报, {"日期", "产品分类", "指标项", "全年预算数"}),
				            "年", each Date.Year([日期]), Int64.Type
				        ),
				        {"产品分类", "年", "指标项"},
				        {{"全年预算数", each List.Max([全年预算数]), type nullable number}}
				    ),
				    合并全年预算 = Table.NestedJoin(添加日期筛选器, {"年", "产品分类", "指标名称"}, 全年预算表, {"年", "产品分类", "指标项"}, "全年预算", JoinKind.LeftOuter),
				    展开全年预算 = Table.ExpandTableColumn(合并全年预算, "全年预算", {"全年预算数"}, {"全年预算数"}),
				    // 内联中间表：月累计实际数（按 月份+产品分类+指标项 汇总）
				    月累计实际表 = Table.TransformColumnTypes(
				        Table.Group(
				            Table.SelectColumns(KFM选冶厂月报, {"月份", "产品分类", "指标项", "累计实际数"}),
				            {"月份", "产品分类", "指标项"},
				            {{"累计实际数", each List.Max([累计实际数]), type nullable number}}
				        ),
				        {{"月份", type text}}
				    ),
				    合并月累计实际 = Table.NestedJoin(展开全年预算, {"上月年月编码", "产品分类", "指标名称"}, 月累计实际表, {"月份", "产品分类", "指标项"}, "月累计实际", JoinKind.LeftOuter),
				    展开月累计实际 = Table.ExpandTableColumn(合并月累计实际, "月累计实际", {"累计实际数"}, {"累计实际数"}),
				    // 收列：一次性完成删列与最终列顺序
				    保留最终列 = Table.SelectColumns(展开月累计实际, {"序号", "环节序号", "排序", "地域", "标准日期", "日期筛选器", "总类别","产品分类", "单位", "指标名称", "二级指标", "当日实际数", "当月累计实际数", "月计划", "月预算", "全年预算数", "累计实际数"}),
				  设置类型 = Table.TransformColumnTypes(保留最终列, {{"序号", Int64.Type}, {"环节序号", Int64.Type}, {"排序", Int64.Type}})
				in
				    设置类型

	annotation PBI_ResultType = Table

