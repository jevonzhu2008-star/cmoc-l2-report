	partition 'L2-03-06 矿石成本分析' = m
		mode: import
		queryGroup: 财经
		source =
				let
				    /*
				    【查询名称】L2-03-06 矿石成本分析 BW 取数
				    【对应报表】L2-03-06 矿石成本分析
				    【BW对象】Cube:ZRCO_CP011，Query:ZRCO_CP011/ZRCO_CP011_Q0015
				    【说明】
				        1、数据源：SharePoint「L2-03-06 矿石成本分析指标映射.xlsx」+ SAP BW QAS（参数 QAS服务器 / 系统编号 / 客户端ID）
				        2、维度：矿体（[ZKT]）、指标项（[ZINDID]）
				        3、指标：13 个考核指标（本年累计、本月实际/预算、差异、环比、累计比预算、累计同比、上年累计、上月实际、同比、预算累计）
				        4、月度循环：p_月报起始日期 ~ p_月报终止日期，逐月传 [ZMSDQNY]=YYYYMM
				        5、清洗：13 个指标 null → 0（避免 DAX DIVIDE/汇总遇空白报错）；加载日期 = 该月 1 日（date），供日期表关系与切片器筛选
				        6、长表化：逆透视保留「矿体 / 指标项 / 加载日期」，13 个指标列转为「指标名称 / 指标值」
				        7、排序：依次左连接「指标名称排序」「矿体排序」「指标项排序」三张映射表，带出对应排序列
				        8、表特有：指标项维度用 [ZINDID]；BW 对象已由 ZRCO_CP005 切到 ZRCO_CP011，表头以代码为准
				    */
				    // ⚠️ 待核对：原注释写 Cube:ZRCO_CP005 / Query:ZRCO_CP005_Q0003，代码已切到 ZRCO_CP011 / ZRCO_CP011_Q0015，上线前确认 BW 侧。
				    // ========== 1. 读取 SharePoint 映射工作簿 ==========
				    // 列出财经 SharePoint 站点全部文件；ApiVersion=15 为较新 REST API，结果是文件清单表
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    // 定位「L2-03-06 矿石成本分析指标映射.xlsx」：按文件名关键字 + 扩展名筛选，取第一份并读取二进制 [Content]
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-03-06 矿石成本分析指标映射") and [Extension] = ".xlsx"){0}[Content],
				    // 工作簿只解析一次，供下面三个排序 Sheet 复用；同一 xlsx 反复解析会拖慢刷新
				    指标映射工作簿 = Excel.Workbook(指标映射文件, true),
				    // 指标名称排序表按「指标名称」去重：保证左连接一对一，否则一键多映射会让事实行翻倍
				    指标名称排序映射表 = Table.Distinct(指标映射工作簿{[Item = "指标名称排序", Kind = "Sheet"]}[Data], {"指标名称"}),
				    // 矿体排序表按「矿体」去重，同样防止连接后行数膨胀
				    矿体排序映射表 = Table.Distinct(指标映射工作簿{[Item = "矿体排序", Kind = "Sheet"]}[Data], {"矿体"}),
				    // 指标项排序表按「指标项」去重，保持维度一对一
				    指标项排序映射表 = Table.Distinct(指标映射工作簿{[Item = "指标项排序", Kind = "Sheet"]}[Data], {"指标项"}),

				    // ========== 2. 连接 BW QAS 环境 ==========
				    // 连接参数：Implementation=2.0 用新版接口 / LanguageCode=ZH 返回中文 / EnableStructures=true 开启内置结构 / BatchSize 放大提升批量拉取性能
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [Implementation="2.0", LanguageCode="ZH", EnableStructures=true, BatchSize=500000000]),
				    // 定位 Cube ZRCO_CP011（只实例化一次，循环内复用，避免每月重建 BW 会话）
				    立方体 = 数据源{[Name="ZRCO_CP011"]}[Data],
				    // 定位 Query ZRCO_CP011/ZRCO_CP011_Q0015，作为后续 Cube.Transform 的基础查询
				    基础查询 = 立方体{[Id="ZRCO_CP011/ZRCO_CP011_Q0015"]}[Data],

				    // ========== 3. 月份循环配置 ==========
				    // 循环起点，取项目参数 p_月报起始日期（date）
				    起始月份 = p_月报起始日期,
				    // 循环终点，取项目参数 p_月报终止日期（date）；跨月后需手动后调，否则取不到新月份
				    结束月份 = p_月报终止日期,
				    // 生成连续月份序列：从起始月起逐月 +1，直到不超过结束月
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 转成 BW 参数要求的 YYYYMM 文本（年×100+月，如 2026-02 → "202602"）；注意此处是文本，日期列另用 #date() 构造
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),

				    // ========== 4. 单月取数函数：展开维度、挂载 13 个指标、null→0、逆透视 ==========
				    // 单月取数函数：入参 month 为 YYYYMM 文本，直接返回当月已清洗、逆透视后的长表
				    查询单月 = (month as text) =>
				        let
				            // 用 Cube.Transform 一次性完成：设置期间参数 → 展开矿体/指标项维度 → 挂载 13 个度量
				            Query = Cube.Transform(基础查询, {
				                // 传入 BW 期间变量 [ZMSDQNY]=当前年月，返回截止该月的累计数据
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                // 展开维度：矿体（[ZKT]）
				                {Cube.AddAndExpandDimensionColumn, "[ZKT]", {"[ZKT].[LEVEL01]"}, {"矿体"}},
				                // 展开维度：指标项（[ZINDID]，该表专用维度）
				                {Cube.AddAndExpandDimensionColumn, "[ZINDID]", {"[ZINDID].[LEVEL01]"}, {"指标项"}},
				                // ===== 13 个考核指标度量 =====
				                {Cube.AddMeasureColumn, "本年累计", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ3FWWI2VUS0XIZZ]"},  // YTD 累计实际
				                {Cube.AddMeasureColumn, "本月实际", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ3FWWHRIITOO2FG]"},  // 当月实际
				                {Cube.AddMeasureColumn, "本月预算", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ3FWWII793UIQ3I]"},  // 当月预算
				                {Cube.AddMeasureColumn, "差异%", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ1PMFWOHZY3WX3F]"},  // 本月实际对本月预算的偏差率
				                {Cube.AddMeasureColumn, "差异±", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ1PMFWOHZY3WQRV]"},  // 本月实际对本月预算的差额
				                {Cube.AddMeasureColumn, "环比%", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ1PMFWOHZY3VV63]"},  // 本月实际对上月实际的变动率
				                {Cube.AddMeasureColumn, "环比±", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ1PMFWOHZY3VOUJ]"},  // 本月实际对上月实际的变动额
				                {Cube.AddMeasureColumn, "累计比预算±", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ1PMFWOHZY3X3EZ]"},  // 本年累计对预算累计的差额
				                {Cube.AddMeasureColumn, "累计同比±", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ1PMFWOHZY3W1HN]"},  // 本年累计对上年同期累计的差额
				                {Cube.AddMeasureColumn, "上年累计", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ3FWWICJ7A37NNW]"},  // 上年同期累计实际
				                {Cube.AddMeasureColumn, "上月实际", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ3FWWC4ZOG9VYZF]"},  // 上月实际
				                {Cube.AddMeasureColumn, "同比%", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ1PMFWOHZY3W7T7]"},  // 本月实际对上年同月的变动率
				                {Cube.AddMeasureColumn, "预算累计", "[4VGQHR12MHZ1PMFWOHZY3UT8R].[4VGQHR12MHZ3FWWIUZETAHTQC]"}  // 本年累计预算
				            }),
				            // 追加「加载日期」= 该月 1 日的 date（如 202602 → 2026-02-01），供日期表关系与年月筛选切片器使用
				            附加月份 = Table.AddColumn(Query, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date),
				            // 13 个指标列的 null 统一替换为 0，避免 DAX 中 DIVIDE、SUM 遇空白报错
				            空值替换为0 = Table.ReplaceValue(附加月份, null, 0, Replacer.ReplaceValue,
				                {"本年累计","本月实际","本月预算","差异%","差异±","环比%","环比±","累计比预算±","累计同比±","上年累计","上月实际","同比%","预算累计"}
				            ),
				            // 逆透视：保留「矿体 / 指标项 / 加载日期」，13 个指标列转为「指标名称 / 指标值」长表
				            逆透视 = Table.UnpivotOtherColumns(空值替换为0, {"矿体","指标项","加载日期"}, "指标名称", "指标值")
				        in
				            逆透视,

				    // ========== 5. 循环取数并合并全月数据 ==========
				    // 对每个 YYYYMM 调用一次查询单月，得到按月的结果表列表
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    // 纵向合并各月长表（各月列结构一致）
				    合并结果 = Table.Combine(各月结果),

				    // ========== 6. 左连接三张排序映射表 ==========
				    // 按「指标名称」左连接指标名称排序表（JoinKind.LeftOuter，未匹配行保留）；映射表已去重，一对一不会放量
				    左连接指标名称排序 = Table.NestedJoin(合并结果, {"指标名称"}, 指标名称排序映射表, {"指标名称"}, "映射指标名称", JoinKind.LeftOuter),
				    // 展开临时映射列，只带出「指标名称排序」
				    展开指标名称排序 = Table.ExpandTableColumn(左连接指标名称排序, "映射指标名称", {"指标名称排序"}, {"指标名称排序"}),
				    // 按「矿体」左连接矿体排序表（JoinKind.LeftOuter，未匹配行保留）；矿体已去重，避免行数翻倍
				    左连接矿体排序 = Table.NestedJoin(展开指标名称排序, {"矿体"}, 矿体排序映射表, {"矿体"}, "映射矿体", JoinKind.LeftOuter),
				    // 展开临时映射列，只带出「矿体排序」
				    展开矿体排序 = Table.ExpandTableColumn(左连接矿体排序, "映射矿体", {"矿体排序"}, {"矿体排序"}),
				    // 按「指标项」左连接指标项排序表（JoinKind.LeftOuter，未匹配行保留）；指标项已去重，保持一对一
				    左连接指标项排序 = Table.NestedJoin(展开矿体排序, {"指标项"}, 指标项排序映射表, {"指标项"}, "映射指标项", JoinKind.LeftOuter),
				    // 展开临时映射列，只带出「指标项排序」
				    展开指标项排序 = Table.ExpandTableColumn(左连接指标项排序, "映射指标项", {"指标项排序"}, {"指标项排序"})
				in
				    展开指标项排序

	annotation PBI_ResultType = Table

