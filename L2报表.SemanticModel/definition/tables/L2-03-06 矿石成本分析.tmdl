	column 指标项排序
		dataType: double
		isHidden
		lineageTag: f504e2ea-f0f6-4db3-8e22-0ebd840bb2f5
		summarizeBy: sum
		sourceColumn: 指标项排序

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

