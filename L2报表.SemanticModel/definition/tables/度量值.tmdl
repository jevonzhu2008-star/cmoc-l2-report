		lineageTag: d38a293a-f67e-467d-a90b-f1ae93af92ca

		formatStringDefinition = FormatAmount()

	/// 实际值：1-12 月分月实际值（求和）
	measure 实际值 = SUM('L2-01-02 集团合并利润汇总表'[实际值])
		displayFolder: L2-01-02 集团合并利润汇总表
