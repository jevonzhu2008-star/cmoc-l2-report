	/// 钴入矿品位（新口径）：累计入磨金属量[钴] ÷ 累计原矿处理量
	measure 钴入矿品位_新口径 = ```
			
			VAR v_CobaltMetal =
			    CALCULATE(
			        SUM('L1-KFM日报'[当月累计实际数]), 
			        'L1-KFM日报'[指标名称] = "入磨金属量", 
			        'L1-KFM日报'[产品分类] = "全钴TCo"
			    ) +
			    CALCULATE(
			        SUM('L1-KFM日报'[累计实际数]),       
			        'L1-KFM日报'[指标名称] = "入磨金属量", 
			        'L1-KFM日报'[产品分类] = "全钴TCo"
			    )
			VAR v_RawOreTonnage =
			    CALCULATE(
			        SUM('L1-KFM日报'[当月累计实际数]), 
			        'L1-KFM日报'[指标名称] = "原矿处理量"
			    ) +
			    CALCULATE(
			        SUM('L1-KFM日报'[累计实际数]),       
			        'L1-KFM日报'[指标名称] = "原矿处理量"
			    )
			RETURN
			    DIVIDE(v_CobaltMetal, v_RawOreTonnage)
			
			```
		displayFolder: 01新口径
		lineageTag: 3bfb8e2b-807a-48d9-8d3e-fe24332e795e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 铜入矿品位（新口径）：累计入磨金属量[铜] ÷ 累计原矿处理量
	measure 铜入矿品位_新口径 = ```
			
