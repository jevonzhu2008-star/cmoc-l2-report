	/// 年累计完成（日报）：按「二级指标」路由口径——原矿钴/铜品位、铜/钴选冶回收率走内联计算，其他指标为空，兜底为当月累计 + 前期累计
	measure 年累计完成L1 = ```
			
			VAR MonthAccActual = SUM('L1-KFM日报'[当月累计实际数])
			VAR YearToPreMonthAccActual = SUM('L1-KFM日报'[累计实际数])
			VAR Res =
			    SWITCH(
			        TRUE(),
			        // 原矿钴品位TCo
			        SELECTEDVALUE('L1-KFM日报'[二级指标]) = "原矿钴品位TCo",
			        CALCULATE(
			            VAR v_CobaltMetal =
			                CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全钴TCo") +
			                CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全钴TCo")
			            VAR v_RawOreTonnage =
			                CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "原矿处理量") +
			                CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称] = "原矿处理量")
			            RETURN
			                DIVIDE(v_CobaltMetal, v_RawOreTonnage)*100,
			            ALLEXCEPT('L1-KFM日报','L1-KFM日报'[日期筛选器])
			        ),
			
			        // 原矿铜品位TCu
			        SELECTEDVALUE('L1-KFM日报'[二级指标]) = "原矿铜品位TCu",
			        CALCULATE(
			            VAR v_CopperMetal =
			                CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全铜TCu") +
			                CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称] = "入磨金属量", 'L1-KFM日报'[产品分类] = "全铜TCu")
			            VAR v_RawOreTonnage =
			                CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称] = "原矿处理量") +
			                CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称] = "原矿处理量")
			            RETURN
			                DIVIDE(v_CopperMetal, v_RawOreTonnage)*100,
			            ALLEXCEPT('L1-KFM日报','L1-KFM日报'[日期筛选器])
			        ),
			
			        // 铜选冶综合回收率TCu
			        SELECTEDVALUE('L1-KFM日报'[二级指标]) = "铜选冶综合回收率TCu",
			        // CALCULATE(
			        //     VAR v_OreCuMetal_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="矿产品产量(金属量)")
			        //     VAR v_LeachRate_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数])/100, 'L1-KFM日报'[指标名称]="浸出率",'L1-KFM日报'[产品分类]="全铜TCu")
			        //     VAR v_WashRate_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数])/100, 'L1-KFM日报'[指标名称]="CCD洗涤效率",'L1-KFM日报'[产品分类]="全铜TCu")
			        //     VAR v_LeachRecMetal_MTD = v_OreCuMetal_MTD * v_LeachRate_MTD
			        //     VAR v_WashRecMetal_MTD = v_OreCuMetal_MTD * v_WashRate_MTD
			
			        //     VAR v_OreCuMetal_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="矿产品产量(金属量)")
			        //     VAR v_LeachRate_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数])/100, 'L1-KFM日报'[指标名称]="浸出率",'L1-KFM日报'[产品分类]="全铜TCu")
			        //     VAR v_WashRate_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数])/100, 'L1-KFM日报'[指标名称]="CCD洗涤效率",'L1-KFM日报'[产品分类]="全铜TCu")
			        //     VAR v_LeachRecMetal_YTD = v_OreCuMetal_YTD * v_LeachRate_YTD
			        //     VAR v_WashRecMetal_YTD = v_OreCuMetal_YTD * v_WashRate_YTD
			
			        //     VAR v_TotalOreCuMetal = v_OreCuMetal_MTD + v_OreCuMetal_YTD
