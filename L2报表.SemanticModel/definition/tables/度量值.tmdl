table 度量值
	lineageTag: 3155867a-412f-4412-aba1-d930d6fe7b51

	/// 当月YTD：实际归母净利 YTD 累计（平均值）
	measure 当月YTD = AVERAGE('L2-01-02 集团合并利润汇总表'[当月YTD])
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: 1cbef3dd-9b3f-435a-8289-8e0727b70953

		formatStringDefinition = FormatAmount()

	/// 去年同期YTD：上一年同期 YTD 实际（平均值）
	measure 去年同期YTD = AVERAGE('L2-01-02 集团合并利润汇总表'[去年同期YTD])
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: a027d72c-8a9b-4a49-b35c-7eefdb7d3199

		formatStringDefinition = FormatAmount()

	/// 预算YTD：YTD 预算（平均值）
	measure 预算YTD = AVERAGE('L2-01-02 集团合并利润汇总表'[预算YTD])
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: 5d7a5fe6-a499-4bf6-b542-21b328e441d5

		formatStringDefinition = FormatAmount()

	/// 当月MTD：所选月份当月实际（平均值）
	measure 当月MTD = AVERAGE('L2-01-02 集团合并利润汇总表'[当月MTD])
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: 0c9655c7-95b3-4e79-aeb3-3f0ac5b5435d

		formatStringDefinition = FormatAmount()

	/// 上月MTD：所选月份上一个月实际（平均值）
	measure 上月MTD = AVERAGE('L2-01-02 集团合并利润汇总表'[上月MTD])
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: d38a293a-f67e-467d-a90b-f1ae93af92ca

		formatStringDefinition = FormatAmount()

	/// 实际值：1-12 月分月实际值（求和）
	measure 实际值 = SUM('L2-01-02 集团合并利润汇总表'[实际值])
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: 7713e5cb-7ef8-4a1e-9c02-103d98de1f32

		formatStringDefinition = FormatAmount()

	/// 同比YTD：YTD 同比变化（百分比，平均值）
	measure 同比YTD = AVERAGE('L2-01-02 集团合并利润汇总表'[同比YTD])/100
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: e3c8e2a2-af68-4765-8762-68f989a8358e

		formatStringDefinition = FormatRatio()

	/// 预算达成率：YTD 预算达成率（百分比，平均值）
	measure 预算达成率 = AVERAGE('L2-01-02 集团合并利润汇总表'[预算达成率])/100
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: 26ab2870-27e9-402e-b6db-2e3872777872

		formatStringDefinition = FormatRatio()

	/// 环比MTD：当月 MTD 环比上月 MTD（百分比，平均值）
	measure 环比MTD = AVERAGE('L2-01-02 集团合并利润汇总表'[环比MTD])/100
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: 477af208-18aa-46b7-829c-7c26486843a6

		formatStringDefinition = FormatRatio()

	/// 累计实际：YTD 累计实际金额（求和）
	measure 累计实际 = SUM('L2-03-01 销售管理费用预算执行汇总表'[累计实际])
		displayFolder: L2-03-01 销售管理费用预算执行汇总表
		lineageTag: 780f0daa-b695-4240-ad7a-e3aba258ce48

		formatStringDefinition = FormatAmount()

	/// 累计实际(千人民币)：YTD 累计实际千元（求和）
	measure 累计实际(千人民币) = SUM('L2-03-01 销售管理费用预算执行汇总表'[累计实际(千人民币)])
		displayFolder: L2-03-01 销售管理费用预算执行汇总表
		lineageTag: d8a9dbec-ffe4-45c6-b97a-85d82e6610f9

		formatStringDefinition = FormatAmount()

	/// 累计预算：YTD 累计预算金额（求和）
	measure 累计预算 = SUM('L2-03-01 销售管理费用预算执行汇总表'[累计预算])
		displayFolder: L2-03-01 销售管理费用预算执行汇总表
		lineageTag: 2e0f7e24-a57a-4b77-878d-c1625bf1dd43

		formatStringDefinition = FormatAmount()

	/// 累计执行%：YTD 预算执行率（百分比，取单值）
	measure 累计执行% = MAX('L2-03-01 销售管理费用预算执行汇总表'[累计执行%])
		displayFolder: L2-03-01 销售管理费用预算执行汇总表
		lineageTag: 8ce40fec-ae04-4341-8207-464e656cb996

		formatStringDefinition = FormatRatio()

	/// 指标值：财务费用分项金额（求和）
	measure L2-03-02指标值 = SUM('L2-03-02 财务费用汇总表'[指标值])
		displayFolder: L2-03-02 财务费用汇总表
		lineageTag: fb0f769c-a919-47cc-a43e-bb2e3aa98866

		formatStringDefinition = FormatAmount()

	/// 动态格式字符串：按当前度量值名（SELECTEDMEASURENAME）从「指标格式配置」表查配置，返回动态格式字符串（类型/小数位数/千分位/负数样式），供度量值 formatStringDefinition 引用
	measure 动态格式字符串 = ```
			
			VAR CurrentMeasureName = SELECTEDMEASURENAME()
			VAR ValType = LOOKUPVALUE('指标格式配置'[指标类型], '指标格式配置'[指标名称], CurrentMeasureName)
			VAR Decimals = LOOKUPVALUE('指标格式配置'[小数位数], '指标格式配置'[指标名称], CurrentMeasureName)
			VAR UseThousandSep = LOOKUPVALUE('指标格式配置'[千分位], '指标格式配置'[指标名称], CurrentMeasureName)
			VAR NegStyle = LOOKUPVALUE('指标格式配置'[负数样式], '指标格式配置'[指标名称], CurrentMeasureName)
			RETURN
			SWITCH(
			    TRUE(),
			    // 查不到配置时，默认0位小数
			    ISBLANK(ValType), "#,0",
			    // 百分比格式
			    ValType = "百分比",
			        IF(NegStyle = "负号",
			            "0." & REPT("0", Decimals) & "%;-" & "0." & REPT("0", Decimals) & "%",
			            "0." & REPT("0", Decimals) & "%;(" & "0." & REPT("0", Decimals) & "%)"
			        ),
			    // 金额/数量/单价格式
			    ValType IN {"金额", "数量", "单价"},
			        IF(UseThousandSep,
			            IF(NegStyle = "括号",
			                "#,0." & REPT("0", Decimals) & ";(#,0." & REPT("0", Decimals) & ");0",
			                "#,0." & REPT("0", Decimals) & ";-#,0." & REPT("0", Decimals) & ";0"
			            ),
			            IF(NegStyle = "括号",
			                "0." & REPT("0", Decimals) & ";(0." & REPT("0", Decimals) & ");0",
			                "0." & REPT("0", Decimals) & ";-0." & REPT("0", Decimals) & ";0"
			            )
			        ),
			    // 兜底
			    "#,0.00"
			)
			
			```
		displayFolder: 00辅助
		lineageTag: 4ca870d5-fdc8-436c-b059-27db949c87f6

	/// 利润汇总表：L2-01-02 集团合并利润汇总表 HTML 表格（季度一级表头，无数据月份隐藏，负数红色，环比MTD 末列，分月 0 不显示）
	measure HTML利润汇总表 = ```
			
			// ============================================================
			// 第一段：计算1~12月每个月的实际值（用于判断哪些月有数据）
			// ============================================================
			VAR _m1 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "1月")
			VAR _m2 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "2月")
			VAR _m3 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "3月")
			VAR _m4 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "4月")
			VAR _m5 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "5月")
			VAR _m6 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "6月")
			VAR _m7 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "7月")
			VAR _m8 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "8月")
			VAR _m9 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "9月")
			VAR _m10 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "10月")
			VAR _m11 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "11月")
			VAR _m12 = CALCULATE(SUM('L2-01-02 集团合并利润汇总表'[实际值]), 'L2-01-02 集团合并利润汇总表'[月份] = "12月")
			
			// ============================================================
			// 第二段：判断每个月是否有数据（非空且非0）
			// 有数据的月份才显示列，没数据的月份自动隐藏
			// ============================================================
			VAR _hasM1 = NOT ISBLANK(_m1) && _m1 <> 0
			VAR _hasM2 = NOT ISBLANK(_m2) && _m2 <> 0
			VAR _hasM3 = NOT ISBLANK(_m3) && _m3 <> 0
			VAR _hasM4 = NOT ISBLANK(_m4) && _m4 <> 0
			VAR _hasM5 = NOT ISBLANK(_m5) && _m5 <> 0
			VAR _hasM6 = NOT ISBLANK(_m6) && _m6 <> 0
			VAR _hasM7 = NOT ISBLANK(_m7) && _m7 <> 0
			VAR _hasM8 = NOT ISBLANK(_m8) && _m8 <> 0
			VAR _hasM9 = NOT ISBLANK(_m9) && _m9 <> 0
			VAR _hasM10 = NOT ISBLANK(_m10) && _m10 <> 0
			VAR _hasM11 = NOT ISBLANK(_m11) && _m11 <> 0
			VAR _hasM12 = NOT ISBLANK(_m12) && _m12 <> 0
			
			// ============================================================
			// 第三段：计算每个季度有几个月有数据
			// 用于表头的colspan合并：Q1合并2列就写colspan="2"
			// ============================================================
			VAR _cQ1 = IF(_hasM1,1,0) + IF(_hasM2,1,0) + IF(_hasM3,1,0)  // Q1有数据的月数
			VAR _cQ2 = IF(_hasM4,1,0) + IF(_hasM5,1,0) + IF(_hasM6,1,0)  // Q2有数据的月数
			VAR _cQ3 = IF(_hasM7,1,0) + IF(_hasM8,1,0) + IF(_hasM9,1,0)  // Q3有数据的月数
			VAR _cQ4 = IF(_hasM10,1,0) + IF(_hasM11,1,0) + IF(_hasM12,1,0)  // Q4有数据的月数
			
			// ============================================================
			// 第四段：构建虚拟表
			// 按「结构」分组，每行是一个利润项目
			// 给每行加上各个指标的值（YTD、同比、预算、分月实际值）
			// ============================================================
			VAR _tbl =
			    ADDCOLUMNS(
			        // 按结构分组，取出所有利润项目
			        SUMMARIZE(
			            'L2-01-02 集团合并利润汇总表',
			            'L2-01-02 集团合并利润汇总表'[结构],
			            'L2-01-02 集团合并利润汇总表'[结构排序]
			        ),
			        // YTD类指标
			        "@当月YTD", [当月YTD],
			        "@同比YTD", [同比YTD],
			        "@预算YTD", [预算YTD],
			        "@预算达成率", [预算达成率],
			        // 1~12月分月实际值
			        "@M1", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "1月"),
			        "@M2", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "2月"),
			        "@M3", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "3月"),
			        "@M4", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "4月"),
			        "@M5", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "5月"),
			        "@M6", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "6月"),
			        "@M7", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "7月"),
			        "@M8", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "8月"),
			        "@M9", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "9月"),
			        "@M10", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "10月"),
			        "@M11", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "11月"),
			        "@M12", CALCULATE([实际值], 'L2-01-02 集团合并利润汇总表'[月份] = "12月"),
			        // 环比指标
			        "@环比MTD", [环比MTD]
			    )
			
			// ============================================================
			// 第五段：把虚拟表转成HTML表格行
			// CONCATENATEX：遍历_tbl的每一行，把表达式拼成一个字符串
			// ============================================================
			VAR _rows =
			    CONCATENATEX(
			        _tbl,
			        "<tr>"
			            // 第1列：项目名称（左对齐）
			            & "<td class='c'>" & [结构] & "</td>"
			            
			            // 第2列：当月YTD（金额类，负数红色带括号）
			            & IF([@当月YTD] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") 
			            & FORMAT([@当月YTD], "#,0;(#,0);0") 
			            & "</td>"
			            
			            // 第3列：同比YTD（百分比类，正数绿色带+号，负数红色）
			            & SWITCH(TRUE(),
			                [@同比YTD] < 0, "<td class='n' style='color:#DC3545;'>-" & FORMAT(ABS([@同比YTD]) * 100, "0.00") & "%</td>",
			                [@同比YTD] = 0, "<td class='n' style='color:#28A745;'>" & FORMAT([@同比YTD] * 100, "0.00") & "%</td>",
			                "<td class='n' style='color:#28A745;'>+" & FORMAT([@同比YTD] * 100, "0.00") & "%</td>"
			            )
			            
			            // 第4列：预算YTD（金额类，负数红色带括号）
			            & IF([@预算YTD] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") 
			            & FORMAT([@预算YTD], "#,0;(#,0);0") 
			            & "</td>"
			            
			            // 第5列：预算达成率（百分比类）
			            & SWITCH(TRUE(),
			                [@预算达成率] < 0, "<td class='n' style='color:#DC3545;'>-" & FORMAT(ABS([@预算达成率]) * 100, "0.00") & "%</td>",
			                [@预算达成率] = 0, "<td class='n' style='color:#28A745;'>" & FORMAT([@预算达成率] * 100, "0.00") & "%</td>",
			                "<td class='n' style='color:#28A745;'>+" & FORMAT([@预算达成率] * 100, "0.00") & "%</td>"
			            )
			            
			            // 第6~17列：1月~12月分月实际值（动态列，有数据才显示，0值显示为空）
			            & IF(_hasM1, IF([@M1] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M1] = 0, "", FORMAT([@M1], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM2, IF([@M2] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M2] = 0, "", FORMAT([@M2], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM3, IF([@M3] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M3] = 0, "", FORMAT([@M3], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM4, IF([@M4] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M4] = 0, "", FORMAT([@M4], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM5, IF([@M5] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M5] = 0, "", FORMAT([@M5], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM6, IF([@M6] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M6] = 0, "", FORMAT([@M6], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM7, IF([@M7] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M7] = 0, "", FORMAT([@M7], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM8, IF([@M8] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M8] = 0, "", FORMAT([@M8], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM9, IF([@M9] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M9] = 0, "", FORMAT([@M9], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM10, IF([@M10] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M10] = 0, "", FORMAT([@M10], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM11, IF([@M11] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M11] = 0, "", FORMAT([@M11], "#,0;(#,0);0")) & "</td>", "")
			            & IF(_hasM12, IF([@M12] < 0, "<td class='n' style='color:#DC3545;'>", "<td class='n'>") & IF([@M12] = 0, "", FORMAT([@M12], "#,0;(#,0);0")) & "</td>", "")
			            
			            // 最后一列：环比MTD（百分比类）
			            & SWITCH(TRUE(),
			                [@环比MTD] < 0, "<td class='n' style='color:#DC3545;'>-" & FORMAT(ABS([@环比MTD]) * 100, "0.00") & "%</td>",
			                [@环比MTD] = 0, "<td class='n' style='color:#28A745;'>" & FORMAT([@环比MTD] * 100, "0.00") & "%</td>",
			                "<td class='n' style='color:#28A745;'>+" & FORMAT([@环比MTD] * 100, "0.00") & "%</td>"
			            ),
			        "",          // 行之间不需要分隔符（已经是<tr>标签）
			        [结构排序],   // 按结构排序列排序
			        ASC          // 升序排列
			    )
			
			// ============================================================
			// 第六段：拼接完整HTML
			// ============================================================
			RETURN
			    // CSS样式
			    "<style>"
			    & ".tb{border-collapse:collapse;font-family:'Segoe UI','Microsoft YaHei',sans-serif;font-size:16px;width:100%;}"
			    & ".tb th{background:#1A2538;color:#fff;padding:6px 6px;border:1px solid #111A29;text-align:center;font-weight:normal;white-space:nowrap;}"
			    & ".tb td{padding:4px 6px;border:1px solid #d9d9d9;}"
			    & ".tb .c{text-align:left;font-weight:500;white-space:nowrap;}"
			    & ".tb .n{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;}"
			    & ".tb .neg{color:#DC3545;}"
			    & ".tb .pos{color:#28A745;}"
			    & ".tb tbody tr:nth-child(even){background:#f5f8fc;}"  // 斑马纹
			    & "</style>"
			    // 表格开始
			    & "<table class='tb'>"
			    // 表头
			    & "<thead>"
			    // 第一层表头：项目、YTD类指标跨2行，季度合并
			    & "<tr>"
			    & "<th rowspan='2'>项目</th>"
			    & "<th rowspan='2'>当月YTD</th><th rowspan='2'>同比YTD</th><th rowspan='2'>预算YTD</th><th rowspan='2'>预算达成率</th>"
			    // 季度表头：有数据的季度才显示，colspan是该季度有几个月
			    & IF(_cQ1 > 0, "<th colspan='" & _cQ1 & "'>Q1</th>", "")
			    & IF(_cQ2 > 0, "<th colspan='" & _cQ2 & "'>Q2</th>", "")
			    & IF(_cQ3 > 0, "<th colspan='" & _cQ3 & "'>Q3</th>", "")
			    & IF(_cQ4 > 0, "<th colspan='" & _cQ4 & "'>Q4</th>", "")
			    & "<th rowspan='2'>环比MTD</th>"
			    & "</tr>"
			    // 第二层表头：月份明细（有数据的月份才显示）
			    & "<tr>"
			    & IF(_hasM1, "<th>1月</th>", "")
			    & IF(_hasM2, "<th>2月</th>", "")
			    & IF(_hasM3, "<th>3月</th>", "")
			    & IF(_hasM4, "<th>4月</th>", "")
			    & IF(_hasM5, "<th>5月</th>", "")
			    & IF(_hasM6, "<th>6月</th>", "")
			    & IF(_hasM7, "<th>7月</th>", "")
			    & IF(_hasM8, "<th>8月</th>", "")
			    & IF(_hasM9, "<th>9月</th>", "")
			    & IF(_hasM10, "<th>10月</th>", "")
			    & IF(_hasM11, "<th>11月</th>", "")
			    & IF(_hasM12, "<th>12月</th>", "")
			    & "</tr>"
			    & "</thead>"
			    // 表体
			    & "<tbody>" & _rows & "</tbody>"
			    & "</table>"
			
			```
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: b16ade29-53f0-48f5-b8a3-3844ead880f8

	/// L2-01-03指标值：快报-金融投资业务专属长表（指标名称+指标值）的指标值求和，报表中配合「指标名称」筛选展示各指标
	measure L2-01-03指标值 = ```
			SUM('L2-01-03 快报-金融投资业务专属'[指标值]) 
			```
		displayFolder: L2-01-03 快报-金融投资业务专属
		lineageTag: e0315754-a628-482f-abb8-94fd9476e555

		formatStringDefinition = FormatAmount()

	/// 金额(人民币)：库存汇总表金额求和（单位：人民币）
	measure 金额(人民币) = SUM('L2-04-01库存汇总表'[金额(人民币)])
		displayFolder: L2-04-01库存汇总表
		lineageTag: db3d5d29-b50b-4a23-857b-20503c3ec9d8

		formatStringDefinition = FormatAmount()

	/// 量(吨)：库存汇总表数量求和（单位：吨）
	measure 量(吨) = SUM('L2-04-01库存汇总表'[量(吨)])
		displayFolder: L2-04-01库存汇总表
		lineageTag: d0d7509a-718e-4f98-ad1f-15492ec8c281

		formatStringDefinition = FormatAmount()

	/// L2-05-01指标值：硫磺及硫酸价格分析月报长表（指标名称+指标值）的指标值求和，报表中配合「指标名称」筛选展示各指标
	measure L2-05-01指标值 = SUM('L2-05-01 硫磺及硫酸价格分析月报'[指标值])
		displayFolder: L2-05-01 硫磺及硫酸价格分析月报
		lineageTag: 1b84b574-ee08-4c40-9052-d6c81de6ab8e

		formatStringDefinition = FormatAmount()

	partition 度量值 = m
		mode: import
		queryGroup: 辅助
		source =
				let
				    源 = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"列 1" = _t]),
				    转换类型 = Table.TransformColumnTypes(源,{{"列 1", type text}}),
				    删除占位列 = Table.RemoveColumns(转换类型,{"列 1"})
				in
				    删除占位列

	annotation PBI_ResultType = Table

