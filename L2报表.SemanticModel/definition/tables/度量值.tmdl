	measure 当前月报期间 = ```
			
			VAR _Date = MAX('日期表'[日期])
			VAR _YearMonth = FORMAT(_Date,"yyyy年MM月")
			RETURN
			 "当前月报期间: " & _YearMonth    
			
			```
		displayFolder: 辅助
		lineageTag: 3bef2f0e-ee99-49e7-ad9c-0e69ad93164d

	partition 度量值 = m
		mode: import
		queryGroup: 辅助
		source =
				let
				    源 = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"列 1" = _t]),
				    转换类型 = Table.TransformColumnTypes(源,{{"列 1", type text}}),
				    删除占位列 = Table.RemoveColumns(转换类型,{"列 1"})
				in
				    删除占位列

	annotation PBI_ResultType = Table

