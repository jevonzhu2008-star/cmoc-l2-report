table 度量值
	lineageTag: 3155867a-412f-4412-aba1-d930d6fe7b51

	/// 当月YTD：实际归母净利 YTD 累计（平均值：逆透视后同一数值按月份重复多行，取平均避免重复累加）
	measure 当月YTD = AVERAGE('L2-01-02 集团合并利润汇总表'[当月YTD])
		displayFolder: L2-01-02 集团合并利润汇总表
		lineageTag: 1cbef3dd-9b3f-435a-8289-8e0727b70953

		formatStringDefinition = FormatAmount()

	/// 去年同期YTD：上一年同期 YTD 实际（平均值：逆透视后同一数值按月份重复多行，取平均避免重复累加）
