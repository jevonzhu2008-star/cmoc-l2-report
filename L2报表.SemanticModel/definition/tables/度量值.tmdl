	/// 月比计划L1：日报当月完成率——% 单位返回差额（百分点差），数量单位返回比率
	measure 月比计划L1 = ```
			
			 // 比率单位（%）→ 差额（百分点差）；数量单位 → 比率
			 IF(
			    SELECTEDVALUE('L1-KFM日报'[单位]) = "%" ,
			    [月累计] - [月计划L1] ,
			    DIVIDE([月累计],[月计划L1])
			 )
