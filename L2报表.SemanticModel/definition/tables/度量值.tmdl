		lineageTag: 0c9655c7-95b3-4e79-aeb3-3f0ac5b5435d

		formatStringDefinition = FormatAmount()

	/// 上月MTD：所选月份上一个月实际（平均值：逆透视后同一数值按月份重复多行，取平均避免重复累加）
	measure 上月MTD = AVERAGE('L2-01-02 集团合并利润汇总表'[上月MTD])
