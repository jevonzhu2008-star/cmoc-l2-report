			        //     VAR v_TotalWashRecMetal = v_WashRecMetal_MTD + v_WashRecMetal_YTD
			
			        //     VAR v_LeachRate_Weighted = DIVIDE(v_TotalLeachRecMetal, v_TotalOreCuMetal)
