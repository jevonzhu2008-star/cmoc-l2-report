	/// 累计实际：YTD 累计实际金额（求和）
	measure 累计实际 = SUM('L2-03-01 销售管理费用预算执行汇总表'[累计实际])
		displayFolder: L2-03-01 销售管理费用预算执行汇总表
		lineageTag: 780f0daa-b695-4240-ad7a-e3aba258ce48

