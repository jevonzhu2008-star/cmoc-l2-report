	/// 累计预算：YTD 累计预算金额（求和）
	measure 累计预算 = SUM('L2-03-01 销售管理费用预算执行汇总表'[累计预算])
		displayFolder: L2-03-01 销售管理费用预算执行汇总表
		lineageTag: 2e0f7e24-a57a-4b77-878d-c1625bf1dd43

