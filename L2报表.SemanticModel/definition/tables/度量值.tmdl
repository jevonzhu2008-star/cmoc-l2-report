	/// 累计执行%：YTD 预算执行率 = 累计实际 / 累计预算（累计预算为 0 时返回 0）
	measure 累计执行% = DIVIDE([累计实际], [累计预算], 0)
		displayFolder: L2-03-01 销售管理费用预算执行汇总表
		lineageTag: 8ce40fec-ae04-4341-8207-464e656cb996

