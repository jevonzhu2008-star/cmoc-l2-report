		formatStringDefinition = FormatAmount()

	/// 铜选冶综合回收率（新口径）：加权浸出率 × 加权洗涤效率 × 0.995
	measure 铜回收率_新口径 = ```
			
			-- ========== MTD 当月累计 ==========
			VAR v_OreCuMetal_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="矿产品产量(金属量)")
			VAR v_LeachRate_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数])/100, 'L1-KFM日报'[指标名称]="浸出率",'L1-KFM日报'[产品分类]="全铜TCu")
			VAR v_WashRate_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数])/100, 'L1-KFM日报'[指标名称]="CCD洗涤效率",'L1-KFM日报'[产品分类]="全铜TCu")
			-- MTD：反推回收金属分子
			VAR v_LeachRecMetal_MTD = v_OreCuMetal_MTD * v_LeachRate_MTD
			VAR v_WashRecMetal_MTD = v_OreCuMetal_MTD * v_WashRate_MTD
			-- ========== YTD 年度累计 ==========
			VAR v_OreCuMetal_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="矿产品产量(金属量)")
			VAR v_LeachRate_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数])/100, 'L1-KFM日报'[指标名称]="浸出率",'L1-KFM日报'[产品分类]="全铜TCu")
			VAR v_WashRate_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数])/100, 'L1-KFM日报'[指标名称]="CCD洗涤效率",'L1-KFM日报'[产品分类]="全铜TCu")
			-- YTD：反推回收金属分子
			VAR v_LeachRecMetal_YTD = v_OreCuMetal_YTD * v_LeachRate_YTD
			VAR v_WashRecMetal_YTD = v_OreCuMetal_YTD * v_WashRate_YTD
			-- ========== 合并：分子相加，分母相加 ==========
			VAR v_TotalOreCuMetal = v_OreCuMetal_MTD + v_OreCuMetal_YTD
			VAR v_TotalLeachRecMetal = v_LeachRecMetal_MTD + v_LeachRecMetal_YTD
			VAR v_TotalWashRecMetal = v_WashRecMetal_MTD + v_WashRecMetal_YTD
			-- 加权浸出率 & 加权洗涤效率
			VAR v_LeachRate_Weighted = DIVIDE(v_TotalLeachRecMetal, v_TotalOreCuMetal)
			VAR v_WashRate_Weighted = DIVIDE(v_TotalWashRecMetal, v_TotalOreCuMetal)
			-- 铜最终回收率，系数0.995
			VAR v_CuFinalRecovery = v_LeachRate_Weighted * v_WashRate_Weighted * 0.995
			RETURN
			    IF(NOT ISBLANK(v_TotalOreCuMetal) && v_TotalOreCuMetal > 0, v_CuFinalRecovery, BLANK())
			
			```
		displayFolder: 01新口径
		lineageTag: e677d72d-d811-4e68-a608-e9dc4891a350

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// 钴选冶综合回收率（新口径）：加权浸出率 × 加权洗涤效率 × 0.98
	measure 钴回收率_新口径 = ```
			
			-- ========== MTD 当月累计 ==========
			VAR v_OreCoMetal_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数]), 'L1-KFM日报'[指标名称]="矿产品产量(金属量)")
			VAR v_LeachRate_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数])/100, 'L1-KFM日报'[指标名称]="浸出率",'L1-KFM日报'[产品分类]="全钴TCo")
			VAR v_WashRate_MTD = CALCULATE(SUM('L1-KFM日报'[当月累计实际数])/100, 'L1-KFM日报'[指标名称]="CCD洗涤效率",'L1-KFM日报'[产品分类]="全钴TCo")
			-- MTD：反推回收金属分子
			VAR v_LeachRecMetal_MTD = v_OreCoMetal_MTD * v_LeachRate_MTD
			VAR v_WashRecMetal_MTD = v_OreCoMetal_MTD * v_WashRate_MTD
			-- ========== YTD 年度累计 ==========
			VAR v_OreCoMetal_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数]), 'L1-KFM日报'[指标名称]="矿产品产量(金属量)")
			VAR v_LeachRate_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数])/100, 'L1-KFM日报'[指标名称]="浸出率",'L1-KFM日报'[产品分类]="全钴TCo")
			VAR v_WashRate_YTD = CALCULATE(SUM('L1-KFM日报'[累计实际数])/100, 'L1-KFM日报'[指标名称]="CCD洗涤效率",'L1-KFM日报'[产品分类]="全钴TCo")
			-- YTD：反推回收金属分子
			VAR v_LeachRecMetal_YTD = v_OreCoMetal_YTD * v_LeachRate_YTD
			VAR v_WashRecMetal_YTD = v_OreCoMetal_YTD * v_WashRate_YTD
			-- ========== 合并：分子相加，分母相加 ==========
			VAR v_TotalOreCoMetal = v_OreCoMetal_MTD + v_OreCoMetal_YTD
			VAR v_TotalLeachRecMetal = v_LeachRecMetal_MTD + v_LeachRecMetal_YTD
			VAR v_TotalWashRecMetal = v_WashRecMetal_MTD + v_WashRecMetal_YTD
			-- 加权浸出率 & 加权洗涤效率
			VAR v_LeachRate_Weighted = DIVIDE(v_TotalLeachRecMetal, v_TotalOreCoMetal)
			VAR v_WashRate_Weighted = DIVIDE(v_TotalWashRecMetal, v_TotalOreCoMetal)
			-- 钴最终回收率，系数0.98
			VAR v_CoFinalRecovery = v_LeachRate_Weighted * v_WashRate_Weighted * 0.98
			RETURN
			    IF(NOT ISBLANK(v_TotalOreCoMetal) && v_TotalOreCoMetal > 0, v_CoFinalRecovery, BLANK())
			
			
			```
