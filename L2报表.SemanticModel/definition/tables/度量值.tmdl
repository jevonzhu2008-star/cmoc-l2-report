		lineageTag: 5d7a5fe6-a499-4bf6-b542-21b328e441d5

		formatStringDefinition = FormatAmount()

	/// 当月MTD：所选月份当月实际（平均值：逆透视后同一数值按月份重复多行，取平均避免重复累加）
	measure 当月MTD = AVERAGE('L2-01-02 集团合并利润汇总表'[当月MTD])
