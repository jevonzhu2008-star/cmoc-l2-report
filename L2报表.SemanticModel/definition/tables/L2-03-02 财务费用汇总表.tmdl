	partition 'L2-03-02 财务费用汇总表' = m
		mode: import
		queryGroup: 财经
		source = ```
				let
				    /*
				    【查询名称】ZRFI_CP010 财务费用汇总表 BW 取数
				    【对应报表】L2-03-02 财务费用汇总表
				    【BW对象】Cube:ZRFI_CP010，Query:ZRFI_CP010_Q0001
				    【说明】
				        1、循环取数：从参数 p_月报起始日期 到 p_月报终止日期，逐月查询 BW 后合并
				        2、BW 参数 [ZMSDQNY]：YYYYMM 格式年月，返回截止当月的 YTD 财务费用数据
				        3、维度：财务费用项目（Structure 内置，输出列名「结构」）
				        4、指标：18 个财务费用分项指标（筹资费用、汇兑损益、利息收支、手续费等）
				        5、末尾逆透视：18 个指标列转成「指标名称」「指标值」长表结构，方便报表按指标筛选展示
				        6、读取 SharePoint 指标映射工作簿的 2 个 Sheet（指标排序、结构排序），左连接带出【指标排序】【结构排序】
				    */
				    // ========== 1. 读取 SharePoint 上的指标与结构排序映射表 ==========
				    // 连接财经 SharePoint 站点，列出全部文件（ApiVersion=15 为较新 REST API），结果为文件列表表
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    // 筛选文件名含「L2-03-02 财务费用汇总表指标映射」且扩展名为 .xlsx 的文件，取第一个并读取其 [Content]（二进制内容）
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-03-02 财务费用汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    // 工作簿只解析一次，后续各 Sheet 直接取用（同一 xlsx 反复解析会拖慢刷新）
				    指标映射工作簿 = Excel.Workbook(指标映射文件, true),
				    指标排序表 = Table.Distinct(指标映射工作簿{[Item = "指标排序", Kind = "Sheet"]}[Data], {"指标名称"}),
				    结构排序表 = Table.Distinct(指标映射工作簿{[Item = "结构排序", Kind = "Sheet"]}[Data], {"结构UniqueName"}),
				    // ========== 2. 连接 BW QAS 环境 ==========
				    // 连接 BW QAS 环境：Implementation=2.0 用新版接口 / LanguageCode=ZH 返回中文 / EnableStructures=true 开启内置结构 / BatchSize 放大提升批量拉取性能
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [Implementation="2.0", LanguageCode="ZH", EnableStructures=true, BatchSize=500000000]),
				    // 按 Cube 名称定位 ZRFI_CP010
				    立方体 = 数据源{[Name="ZRFI_CP010"]}[Data],
				    // 按 Query ID 定位 ZRFI_CP010/ZRFI_CP010_Q0001
				    基础查询 = 立方体{[Id="ZRFI_CP010/ZRFI_CP010_Q0001"]}[Data],
				    // ========== 3. 月份循环配置 ==========
				    // 循环起始月份，取自 Power BI 参数 p_月报起始日期（date 类型）
				    起始月份 = p_月报起始日期,
				    // 循环结束月份，取自 Power BI 参数 p_月报终止日期（date 类型）
				    结束月份 = p_月报终止日期,
				    // 生成连续月份序列：从起始月份起每月 +1，直到不超过结束月份（结果为 date 列表）
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 把每个日期转成 BW 要求的 YYYYMM 文本：年×100 + 月（如 2026 年 1 月 → "202601"）
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				    // ========== 4. 度量值公共前缀 ==========
				    度量前缀 = "[4VGQHR12MHZ1PJONR9LZX5FVY].[4VGQHR12MHZ1PJONR9LZX",
				    // ========== 5. 单月取数函数 ==========
				    // 单月取数函数：输入 YYYYMM 文本，输出该月 BW 查询结果表
				    查询单月 = (month as text) =>
				        let
				            // 对基础查询应用一组 BW 变换：设置期间参数、展开维度、添加度量值
				            Query = Cube.Transform(基础查询, {
				                // 设置 BW 期间参数 [ZMSDQNY] = 当前循环月份
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                // 展开内置结构维度（财务费用项目），输出列名「结构」
				                {Cube.AddAndExpandDimensionColumn, "[4VGQHR12MHZ1PJONR9LZX6HTA]", {"[4VGQHR12MHZ1PJONR9LZX6HTA]"}, {"结构"}},
				                // ========== 财务费用分项指标 ==========
				                {Cube.AddMeasureColumn, "财务费用", 度量前缀 & "9AY6]"},
				                {Cube.AddMeasureColumn, "筹资费用", 度量前缀 & "BL4E]"},
				                {Cube.AddMeasureColumn, "汇兑损益", 度量前缀 & "BRFY]"},
				                {Cube.AddMeasureColumn, "集团内部资金占用费收入", 度量前缀 & "B25Q]"},
				                {Cube.AddMeasureColumn, "集团内部资金占用费支出", 度量前缀 & "A6JY]"},
				                {Cube.AddMeasureColumn, "金属流、邦普借款及其他利息支出", 度量前缀 & "ACVI]"},
				                {Cube.AddMeasureColumn, "净利息支出(利息支出+利息资本化)", 度量前缀 & "9H9Q]"},
				                {Cube.AddMeasureColumn, "利息收入", 度量前缀 & "AVU6]"},
				                {Cube.AddMeasureColumn, "利息收入-小计", 度量前缀 & "APIM]"},
				                {Cube.AddMeasureColumn, "利息支出", 度量前缀 & "9NLA]"},
				                {Cube.AddMeasureColumn, "利息支出资本化", 度量前缀 & "AJ72]"},
				                {Cube.AddMeasureColumn, "其他利息收入", 度量前缀 & "B8HA]"},
				                {Cube.AddMeasureColumn, "手续费", 度量前缀 & "BESU]"},
				                {Cube.AddMeasureColumn, "外汇套保损益", 度量前缀 & "CAEM]"},
				                {Cube.AddMeasureColumn, "银行借款利息支出", 度量前缀 & "A08E]"},
				                {Cube.AddMeasureColumn, "银行理财收益及票据贴现利息", 度量前缀 & "C432]"},
				                {Cube.AddMeasureColumn, "债券利息支出", 度量前缀 & "9TWU]"},
				                {Cube.AddMeasureColumn, "折现费用", 度量前缀 & "BXRI]"}
				            }),
				            // 获取结构成员唯一 ID，供结构排序映射左连接使用
				            添加结构唯一ID = Table.AddColumn(Query, "结构唯一ID", each Cube.AttributeMemberProperty([结构], "[MEMBER_UNIQUE_NAME]")),
				            // 追加「加载日期」列：把当前循环 YYYYMM 转成当月首日 date（如 202601 → 2026-01-01），标记该行数据所属期间
				            附加加载日期 = Table.AddColumn(添加结构唯一ID, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date)
				        in
				            附加加载日期,
				    // ========== 6. 循环遍历月份，逐个取数 ==========
				    // 遍历月份文本列表，对每个 YYYYMM 调用查询单月，得到 N 个月的结果表
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    // ========== 7. 合并所有月份的宽表 ==========
				    // 把 N 个月的结果表上下合并成一张宽表
				    合并宽表 = Table.Combine(各月结果),
				    // ========== 8. 逆透视（宽表转长表） ==========
				    // 保留的列：结构、结构唯一ID、加载日期
				    // 被逆透视的列：其余全部 18 个 Measure 列
				    逆透视长表 = Table.UnpivotOtherColumns(
				        合并宽表,
				        {"结构", "结构唯一ID", "加载日期"},
				        "指标名称",
				        "指标值"
				    ),
				    // ========== 9. 空值处理 ==========
				    // 把 0 统一置为 null，避免报表展示无意义的 0；副作用是真实为 0 的行也会变空
				    清洗空值 = Table.ReplaceValue(逆透视长表, 0, null, Replacer.ReplaceValue, {"指标值"}),
				    // ========== 10. 左连接「指标排序」映射表 ==========
				    // 左连接「指标排序」映射表（按指标名称匹配；JoinKind.LeftOuter，未匹配行保留）
				    左连接指标排序 = Table.NestedJoin(清洗空值, {"指标名称"}, 指标排序表, {"指标名称"}, "指标映射临时", JoinKind.LeftOuter),
				    // 展开临时映射列，仅保留「指标排序」字段
				    展开指标排序 = Table.ExpandTableColumn(左连接指标排序, "指标映射临时", {"指标排序"}, {"指标排序"}),
				    // ========== 11. 左连接「结构排序」映射表 ==========
				    // 左连接「结构排序」映射表（按「结构唯一ID」匹配「结构UniqueName」；JoinKind.LeftOuter，未匹配行保留）
				    左连接结构排序 = Table.NestedJoin(展开指标排序, {"结构唯一ID"}, 结构排序表, {"结构UniqueName"}, "结构映射临时", JoinKind.LeftOuter),
				    // 展开临时映射列，仅保留「结构排序」字段
				    展开结构排序 = Table.ExpandTableColumn(左连接结构排序, "结构映射临时", {"结构排序"}, {"结构排序"})
				in
				    展开结构排序
				```

	annotation PBI_ResultType = Table

