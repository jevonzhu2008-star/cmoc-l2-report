	partition 'L2-03-02 财务费用汇总表' = m
		mode: import
		queryGroup: 财经\多月
		source = ```
				let
				    /*
				    【查询名称】ZRFI_CP010 财务费用BW取数
				    【对应报表】L2-03-02 财务费用汇总表
				    【BW对象】Cube:ZRFI_CP010   Query:ZRFI_CP010_Q0001
				    */
				    
				    // ========== 读取SharePoint上的指标&结构排序映射表 ==========
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-03-02 财务费用汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    指标排序表 = Excel.Workbook(指标映射文件, true){[Item = "指标排序", Kind = "Sheet"]}[Data],
				    结构排序表 = Excel.Workbook(指标映射文件, true){[Item = "结构排序", Kind = "Sheet"]}[Data],
				    
				    // ========== 连接BW QAS环境 ==========
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [Implementation="2.0", LanguageCode="ZH", EnableStructures=true, BatchSize=500000000]),
				    立方体 = 数据源{[Name="ZRFI_CP010"]}[Data],
				    基础查询 = 立方体{[Id="ZRFI_CP010/ZRFI_CP010_Q0001"]}[Data],
				    
				    // ========== 月份循环配置 ==========
				    起始月份 = p_月报起始日期,
				    结束月份 = p_月报终止日期,
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				    
				    // ========== Measure公共前缀（提取出来，避免重复写） ==========
				    MeasureCube = "[4VGQHR12MHZ1PJONR9LZX5FVY].[4VGQHR12MHZ1PJONR9LZX",
				    
				    // ========== 单月取数函数（只做BW查询，不做逆透视） ==========
				    查询单月 = (month as text) =>
				        let
				            Query = Cube.Transform(基础查询, {
				                // BW期间参数
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                
				                // 展开内置结构维度（财务费用项目）
				                {Cube.AddAndExpandDimensionColumn, "[4VGQHR12MHZ1PJONR9LZX6HTA]", {"[4VGQHR12MHZ1PJONR9LZX6HTA]"}, {"结构"}},
				                
				                // 财务费用分项度量值
				                {Cube.AddMeasureColumn, "财务费用", MeasureCube & "9AY6]"},
				                {Cube.AddMeasureColumn, "筹资费用", MeasureCube & "BL4E]"},
				                {Cube.AddMeasureColumn, "汇兑损益", MeasureCube & "BRFY]"},
				                {Cube.AddMeasureColumn, "集团内部资金占用费收入", MeasureCube & "B25Q]"},
				                {Cube.AddMeasureColumn, "集团内部资金占用费支出", MeasureCube & "A6JY]"},
				                {Cube.AddMeasureColumn, "金属流、邦普借款及其他利息支出", MeasureCube & "ACVI]"},
				                {Cube.AddMeasureColumn, "净利息支出(利息支出+利息资本化)", MeasureCube & "9H9Q]"},
				                {Cube.AddMeasureColumn, "利息收入", MeasureCube & "AVU6]"},
				                {Cube.AddMeasureColumn, "利息收入-小计", MeasureCube & "APIM]"},
				                {Cube.AddMeasureColumn, "利息支出", MeasureCube & "9NLA]"},
				                {Cube.AddMeasureColumn, "利息支出资本化", MeasureCube & "AJ72]"},
				                {Cube.AddMeasureColumn, "其他利息收入", MeasureCube & "B8HA]"},
				                {Cube.AddMeasureColumn, "手续费", MeasureCube & "BESU]"},
				                {Cube.AddMeasureColumn, "外汇套保损益", MeasureCube & "CAEM]"},
				                {Cube.AddMeasureColumn, "银行借款利息支出", MeasureCube & "A08E]"},
				                {Cube.AddMeasureColumn, "银行理财收益及票据贴现利息", MeasureCube & "C432]"},
				                {Cube.AddMeasureColumn, "债券利息支出", MeasureCube & "9TWU]"},
				                {Cube.AddMeasureColumn, "折现费用", MeasureCube & "BXRI]"}
				            }),
				            
				            // 获取结构唯一ID
				            添加结构唯一ID = Table.AddColumn(Query, "结构唯一ID", each Cube.AttributeMemberProperty([结构], "[MEMBER_UNIQUE_NAME]")),
				            // 附加加载年月
				            附加加载年月 = Table.AddColumn(添加结构唯一ID, "加载年月", each month, type text)
				        in
				            附加加载年月,
				    
				    // ========== 循环遍历月份，逐个取数 ==========
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    
				    // ========== 先合并所有月份的宽表（只合并一次） ==========
				    合并宽表 = Table.Combine(各月结果),
				    
				    // ========== 再逆透视（只做一次，不是每个月做一次） ==========
				    // 保留的列：结构、结构唯一ID、加载年月
				    // 被逆透视的列：所有18个Measure列
				    逆透视长表 = Table.UnpivotOtherColumns(
				        合并宽表, 
				        {"结构", "结构唯一ID", "加载年月"}, 
				        "指标名称", 
				        "指标值"
				    ),
				    
				    // ========== 统一处理空值（最后做一次，不是每个月做一次） ==========
				    // 把null和0都换成null，避免报表展示0干扰
				    清洗空值 = Table.ReplaceValue(逆透视长表, 0, null, Replacer.ReplaceValue, {"指标值"}),
				    
				    // ========== 左连接映射表，带出【指标排序】 ==========
				    左连接指标排序 = Table.NestedJoin(清洗空值, {"指标名称"}, 指标排序表, {"指标名称"}, "指标映射临时", JoinKind.LeftOuter),
				    展开指标排序 = Table.ExpandTableColumn(左连接指标排序, "指标映射临时", {"指标排序"}, {"指标排序"}),
				    
				    // ========== 左连接映射表，带出【结构排序】 ==========
				    左连接结构排序 = Table.NestedJoin(展开指标排序, {"结构唯一ID"}, 结构排序表, {"结构UniqueName"}, "结构映射临时", JoinKind.LeftOuter),
				    展开结构排序 = Table.ExpandTableColumn(左连接结构排序, "结构映射临时", {"结构排序"}, {"结构排序"})
				in
				    展开结构排序
				```

	annotation PBI_ResultType = Table

