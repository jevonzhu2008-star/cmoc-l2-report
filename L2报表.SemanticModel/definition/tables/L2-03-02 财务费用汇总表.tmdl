	partition 'L2-03-02 财务费用汇总表' = m
		mode: import
		queryGroup: 财经
		source =
				let
				    /*
				    【查询名称】L2-03-02 财务费用汇总表 BW 取数
				    【对应报表】L2-03-02 财务费用汇总表
				    【BW对象】Cube:ZRFI_CP010，Query:ZRFI_CP010/ZRFI_CP010_Q0001
				    【说明】
				        1、数据源：SharePoint「L2-03-02 财务费用汇总表指标映射.xlsx」+ SAP BW QAS（参数 QAS服务器 / 系统编号 / 客户端ID）
				        2、维度：财务费用项目（BW 内置结构，展开后输出列名「结构」）；另派生「结构唯一ID」作为排序匹配键
				        3、指标：18 个财务费用分项（财务费用、筹资费用、汇兑损益、利息收入/支出、手续费、折现费用等）
				        4、月度循环：p_月报起始日期 ~ p_月报终止日期，逐月传 [ZMSDQNY]=YYYYMM
				        5、清洗：逆透视后把「指标值」中的 0 置为 null，避免报表展示无意义零值（真实为 0 的行也会显示为空白）
				        6、长表化：逆透视保留「结构 / 结构唯一ID / 加载日期」，其余 18 个度量列转为「指标名称 / 指标值」
				        7、排序：左连接「指标排序」表（键 指标名称）与「结构排序」表（键 结构唯一ID ↔ 结构UniqueName），带出「指标排序」「结构排序」
				        8、表特有：BW 内置结构须用 Cube.AttributeMemberProperty 取 [MEMBER_UNIQUE_NAME] 生成「结构唯一ID」，否则无法对齐 SharePoint 结构排序表
				    */
				    // ========== 1. 读取 SharePoint 映射工作簿 ==========
				    // 列出财经 SharePoint 站点全部文件；ApiVersion=15 为较新 REST API，结果是文件清单表
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    // 定位「L2-03-02 财务费用汇总表指标映射.xlsx」：按文件名关键字 + 扩展名筛选，取第一份并读取二进制 [Content]
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-03-02 财务费用汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    // 工作簿只解析一次，供下面两个排序 Sheet 复用；同一 xlsx 反复解析会拖慢刷新
				    指标映射工作簿 = Excel.Workbook(指标映射文件, true),
				    // 指标排序表按「指标名称」去重：保证左连接一对一，否则一键多映射会让事实行翻倍
				    指标排序表 = Table.Distinct(指标映射工作簿{[Item = "指标排序", Kind = "Sheet"]}[Data], {"指标名称"}),
				    // 结构排序表按「结构UniqueName」去重；该键与 BW 结构成员唯一名一一对应
				    结构排序表 = Table.Distinct(指标映射工作簿{[Item = "结构排序", Kind = "Sheet"]}[Data], {"结构UniqueName"}),
				    // ========== 2. 连接 BW QAS 环境 ==========
				    // 连接参数：Implementation=2.0 用新版接口 / LanguageCode=ZH 返回中文 / EnableStructures=true 开启内置结构 / BatchSize 放大提升批量拉取性能
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [Implementation="2.0", LanguageCode="ZH", EnableStructures=true, BatchSize=500000000]),
				    // 定位 Cube ZRFI_CP010（只实例化一次，循环内复用，避免每月重建 BW 会话）
				    立方体 = 数据源{[Name="ZRFI_CP010"]}[Data],
				    // 定位 Query ZRFI_CP010/ZRFI_CP010_Q0001，作为后续 Cube.Transform 的基础查询
				    基础查询 = 立方体{[Id="ZRFI_CP010/ZRFI_CP010_Q0001"]}[Data],
				    // ========== 3. 月份循环配置 ==========
				    // 循环起点，取项目参数 p_月报起始日期（date）
				    起始月份 = p_月报起始日期,
				    // 循环终点，取项目参数 p_月报终止日期（date）；跨月后需手动后调，否则取不到新月份
				    结束月份 = p_月报终止日期,
				    // 生成连续月份序列：从起始月起逐月 +1，直到不超过结束月
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    // 转成 BW 参数要求的 YYYYMM 文本（年×100+月，如 2026 年 1 月 → "202601"）；注意此处是文本，日期列另用 #date() 构造
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				    // ========== 4. 单月取数函数：设置期间参数、展开维度、挂载 18 个财务费用指标 ==========
				    // BW 度量 ID 的公共前缀，18 个度量在此前缀上拼接各自后缀
				    度量前缀 = "[4VGQHR12MHZ1PJONR9LZX5FVY].[4VGQHR12MHZ1PJONR9LZX",
				    // 单月取数函数：入参 month 为 YYYYMM 文本，输出该月已挂维度/度量并追加「加载日期」的结果表
				    查询单月 = (month as text) =>
				        let
				            // 用 Cube.Transform 一次性完成：设置期间参数 → 展开结构维度 → 挂载 18 个财务费用度量
				            Query = Cube.Transform(基础查询, {
				                // 传入 BW 期间变量 [ZMSDQNY]=当前年月，返回截止该月的 YTD 财务费用
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                // 展开内置结构维度（财务费用项目），输出列名「结构」
				                {Cube.AddAndExpandDimensionColumn, "[4VGQHR12MHZ1PJONR9LZX6HTA]", {"[4VGQHR12MHZ1PJONR9LZX6HTA]"}, {"结构"}},
				                // ===== 18 个财务费用分项度量 =====
				                {Cube.AddMeasureColumn, "财务费用", 度量前缀 & "9AY6]"},                        // 财务费用合计口径
				                {Cube.AddMeasureColumn, "筹资费用", 度量前缀 & "BL4E]"},                        // 筹资活动相关费用
				                {Cube.AddMeasureColumn, "汇兑损益", 度量前缀 & "BRFY]"},                        // 汇兑损益
				                {Cube.AddMeasureColumn, "集团内部资金占用费收入", 度量前缀 & "B25Q]"},          // 集团内部资金往来（收入）
				                {Cube.AddMeasureColumn, "集团内部资金占用费支出", 度量前缀 & "A6JY]"},          // 集团内部资金往来（支出）
				                {Cube.AddMeasureColumn, "金属流、邦普借款及其他利息支出", 度量前缀 & "ACVI]"},  // 非银行借款渠道的利息支出
				                {Cube.AddMeasureColumn, "净利息支出(利息支出+利息资本化)", 度量前缀 & "9H9Q]"}, // 利息支出扣除利息资本化后的净额
				                {Cube.AddMeasureColumn, "利息收入", 度量前缀 & "AVU6]"},                        // 利息收入
				                {Cube.AddMeasureColumn, "利息收入-小计", 度量前缀 & "APIM]"},                   // 利息收入小计口径
				                {Cube.AddMeasureColumn, "利息支出", 度量前缀 & "9NLA]"},                        // 利息支出
				                {Cube.AddMeasureColumn, "利息支出资本化", 度量前缀 & "AJ72]"},                  // 资本化计入资产成本的利息
				                {Cube.AddMeasureColumn, "其他利息收入", 度量前缀 & "B8HA]"},                    // 主营以外的利息收入
				                {Cube.AddMeasureColumn, "手续费", 度量前缀 & "BESU]"},                          // 银行及融资手续费
				                {Cube.AddMeasureColumn, "外汇套保损益", 度量前缀 & "CAEM]"},                    // 外汇套期保值产生的损益
				                {Cube.AddMeasureColumn, "银行借款利息支出", 度量前缀 & "A08E]"},                // 银行借款对应的利息支出
				                {Cube.AddMeasureColumn, "银行理财收益及票据贴现利息", 度量前缀 & "C432]"},      // 理财收益 + 票据贴现利息
				                {Cube.AddMeasureColumn, "债券利息支出", 度量前缀 & "9TWU]"},                    // 债券融资对应的利息支出
				                {Cube.AddMeasureColumn, "折现费用", 度量前缀 & "BXRI]"}                         // 折现相关费用
				            }),
				            // 取结构成员的 [MEMBER_UNIQUE_NAME] 生成「结构唯一ID」：显示名会变而唯一名稳定，用作结构排序匹配键
				            添加结构唯一ID = Table.AddColumn(Query, "结构唯一ID", each Cube.AttributeMemberProperty([结构], "[MEMBER_UNIQUE_NAME]")),
				            // 追加「加载日期」= 该月 1 日的 date（如 202601 → 2026-01-01），供日期表关系与年月筛选切片器使用
				            附加加载日期 = Table.AddColumn(添加结构唯一ID, "加载日期", each #date(Number.From(Text.Start(month, 4)), Number.From(Text.End(month, 2)), 1), type date)
				        in
				            附加加载日期,
				    // ========== 5. 循环取数并合并全月宽表 ==========
				    // 对每个 YYYYMM 调用一次查询单月，得到按月的结果表列表
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    // 纵向合并各月宽表（各月列结构一致）
				    合并宽表 = Table.Combine(各月结果),
				    // ========== 6. 逆透视（宽表转长表） ==========
				    // 保留「结构 / 结构唯一ID / 加载日期」三列，其余 18 个度量列逆透视为「指标名称 / 指标值」
				    逆透视长表 = Table.UnpivotOtherColumns(
				        合并宽表,
				        {"结构", "结构唯一ID", "加载日期"},
				        "指标名称",
				        "指标值"
				    ),
				    // ========== 7. 清洗零值 ==========
				    // 把「指标值」中的 0 置为 null，避免报表展示无意义的 0；代价是真实为 0 的行也会显示为空白
				    清洗空值 = Table.ReplaceValue(逆透视长表, 0, null, Replacer.ReplaceValue, {"指标值"}),
				    // ========== 8. 左连接「指标排序」映射表 ==========
				    // 按「指标名称」左连接（JoinKind.LeftOuter，未匹配行保留）；映射表已去重，一对一不会放量
				    左连接指标排序 = Table.NestedJoin(清洗空值, {"指标名称"}, 指标排序表, {"指标名称"}, "指标映射临时", JoinKind.LeftOuter),
				    // 展开临时映射列，只带出「指标排序」
				    展开指标排序 = Table.ExpandTableColumn(左连接指标排序, "指标映射临时", {"指标排序"}, {"指标排序"}),
				    // ========== 9. 左连接「结构排序」映射表 ==========
				    // 按「结构唯一ID」匹配「结构UniqueName」左连接（JoinKind.LeftOuter，未匹配行保留）；映射表已按该键去重
				    左连接结构排序 = Table.NestedJoin(展开指标排序, {"结构唯一ID"}, 结构排序表, {"结构UniqueName"}, "结构映射临时", JoinKind.LeftOuter),
				    // 展开临时映射列，只带出「结构排序」
				    展开结构排序 = Table.ExpandTableColumn(左连接结构排序, "结构映射临时", {"结构排序"}, {"结构排序"})
				in
				    展开结构排序

	annotation PBI_ResultType = Table

