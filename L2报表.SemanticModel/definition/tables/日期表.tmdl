table 日期表
	lineageTag: df0a8718-772c-4e4a-9063-c45ed6ec6480

	column 日期
		dataType: dateTime
		formatString: Long Date
		lineageTag: c413d148-c971-4a39-b1eb-8558ccb82ce6
		summarizeBy: none
		sourceColumn: 日期

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 年
		dataType: string
		lineageTag: 87a0752f-a4f9-4238-b1f4-7bed75d57549
		summarizeBy: none
		sourceColumn: 年
		sortByColumn: 年排序

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 月
		dataType: string
		lineageTag: 6bd5a14f-3806-42cf-b00b-cb8fb4cfe2ad
		summarizeBy: none
		sourceColumn: 月
		sortByColumn: 月排序

