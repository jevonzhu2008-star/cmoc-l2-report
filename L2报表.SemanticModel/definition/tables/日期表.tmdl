	column 年月
		dataType: int64
		formatString: 0
		lineageTag: a08d4dd2-ba49-444e-9c6b-965937a4f432
		summarizeBy: sum
		sourceColumn: 年月

		annotation SummarizationSetBy = Automatic

	column 年排序
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2de7929c-7dc3-4502-9075-c51472faab07
		summarizeBy: sum
		sourceColumn: 年排序

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 月排序
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0f39ddae-02df-4a34-803d-eeec19d686e1
		summarizeBy: sum
		sourceColumn: 月排序

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 年月筛选
		dataType: string
		lineageTag: 2d75113b-3235-4798-953f-c4887b9460fa
		summarizeBy: none
		sourceColumn: 年月筛选
		sortByColumn: 年月

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition 日期表 = m
		mode: import
		queryGroup: 辅助
		source =
				let
				    /*
				    【查询名称】日期表 参数内生成（无外部数据源）
				    【对应报表】全部内容页共用的日期维度；各内容页「年月筛选」切片器、「当前月报期间」卡片
				    【数据源】无外部数据源，由 Power BI 参数 p_月报起始日期 / p_月报终止日期 在 M 内生成
				    【说明】
				        1、数据来源：参数 p_月报起始日期（含）~ p_月报终止日期（含），逐日连续生成，不读任何外部表
				        2、维度/字段：日期、年、月、年月、年排序、月排序、年月筛选；年排序 / 月排序 为隐藏排序列（sortByColumn）
				        3、生成口径：List.Dates 逐日展开；【年月筛选】把范围内最大年月显示为「最近月份」，其余为 yyyy-MM
				        4、为什么是这个口径：日期范围必须与 11 张事实表的循环取数范围一致，否则切片器会滤掉有效月份；「最近月份」让各内容页切片器默认落在最新月份，翻页时靠同名 syncGroup 保持一致
				        5、被谁使用：11 张事实表的【加载日期】都与本表【日期】建一对多关系；内容页的「年月筛选」切片器、卡片「当前月报期间」均取自本表，【年月筛选】口径不得改动，其排序依赖本表【年月】
				    */
				    // ========== 1. 起止日期（取数范围参数） ==========
				    // 起始日期：参数 p_月报起始日期（含），必须与事实表循环取数起点一致
				    起始日期 = p_月报起始日期,
				    // 结束日期：参数 p_月报终止日期（含），决定日期表上界与「最近月份」的判定
				    结束日期 = p_月报终止日期,
				    // ========== 2. 生成连续日期序列（含首尾） ==========
				    // 天数 = 日期差 + 1：List.Dates 的 count 不含终点，+1 才能把首尾两天都纳入
				    天数 = Duration.Days(结束日期 - 起始日期) + 1,
				    // 逐日生成 date 列表，步长 1 天
				    日期列表 = List.Dates(起始日期, 天数, #duration(1, 0, 0, 0)),
				    // ========== 3. 列表转表并设为 date 类型 ==========
				    // 单列列表转表，列名【日期】
				    日期表 = Table.FromList(日期列表, Splitter.SplitByNothing(), {"日期"}, null, ExtraValues.Error),
				    // 显式转为 date：年月、月排序等派生列与关系键都依赖真实日期类型，不能留 any
				    日期类型 = Table.TransformColumnTypes(日期表, {{"日期", type date}}),
				    // ========== 4. 派生 年 / 月 / 年月 ==========
				    // 年：文本「2026年」用于展示；排序交给隐藏列【年排序】
				    加年 = Table.AddColumn(日期类型, "年", each Text.From(Date.Year([日期])) & "年", type text),
				    // 月：文本「1月」~「12月」用于展示；排序交给隐藏列【月排序】
				    加月 = Table.AddColumn(加年, "月", each Text.From(Date.Month([日期])) & "月", type text),
				    // 年月：数值键 202601（年×100+月），同时是【年月筛选】的 sortByColumn
				    加年月 = Table.AddColumn(加月, "年月", each Date.Year([日期]) * 100 + Date.Month([日期]), Int64.Type),
				    // ========== 5. 派生排序键（供 sortByColumn） ==========
				    // 年排序：年份整数，保证【年】按 2025 → 2026 排序而不是按文本
				    加年排序 = Table.AddColumn(加年月, "年排序", each Date.Year([日期]), Int64.Type),
				    // 月排序：月份整数 1~12，保证【月】按自然月排序
				    加月排序 = Table.AddColumn(加年排序, "月排序", each Date.Month([日期]), Int64.Type),
				    // ========== 6. 【年月筛选】：各内容页切片器字段 ==========
				    // 范围内最大年月：日期列表止于 p_月报终止日期，所以它就是终止日期所在月
				    最大年月 = List.Max(加月排序[年月]),
				    // 【年月筛选】口径：最大年月显示「最近月份」，其余显示 yyyy-MM；Text.PadStart 保证月份两位；这是各内容页切片器的字段，口径不能改
				    加年月筛选 = Table.AddColumn(加月排序, "年月筛选", each
				        if [年月] = 最大年月
				            then "最近月份"
				            else Text.From(Date.Year([日期])) & "-" & Text.PadStart(Text.From(Date.Month([日期])), 2, "0"),
				        type text
				    ),
				    // ========== 7. 按日期升序排列 ==========
				    // 按日期升序输出，保证日期表有序、与事实表关系按键对齐；Power BI 也据此把本表标记为日期表
				    结果 = Table.Sort(加年月筛选, {{"日期", Order.Ascending}})
				in
				    结果

	annotation PBI_ResultType = Table

