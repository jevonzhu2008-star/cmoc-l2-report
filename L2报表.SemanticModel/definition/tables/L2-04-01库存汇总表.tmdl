	partition L2-04-01库存汇总表 = m
		mode: import
		queryGroup: 财经\多月
		source = ```
				let
				    /*
				    【查询名称】ZRMM_CP002 矿石成本分析BW取数
				    【对应报表】L2-02-04 矿石成本分析
				    【BW对象】Cube:ZRMM_CP002   Query:ZRMM_CP002_Q0001
				    */
				    
				    // ========== 读取SharePoint上的排序映射表 ==========
				    源 = SharePoint.Files(财经SharePoint站点, [ApiVersion = 15]),
				    指标映射文件 = Table.SelectRows(源, each Text.Contains([Name], "L2-04-01库存汇总表指标映射") and [Extension] = ".xlsx"){0}[Content],
				    分类排序表 = Excel.Workbook(指标映射文件, true){[Item = "分类排序", Kind = "Sheet"]}[Data],
				    结构排序表 = Excel.Workbook(指标映射文件, true){[Item = "结构排序", Kind = "Sheet"]}[Data],
				    矿体排序表 = Excel.Workbook(指标映射文件, true){[Item = "矿体排序", Kind = "Sheet"]}[Data],
				    
				    // ========== 连接BW QAS环境 ==========
				    数据源 = SapBusinessWarehouse.Cubes(QAS服务器, 系统编号, 客户端ID, [LanguageCode="ZH", Implementation="2.0", EnableStructures=true, BatchSize=500000000]),
				    立方体 = 数据源{[Name="ZRMM_CP002"]}[Data],
				    基础查询 = 立方体{[Id="ZRMM_CP002/ZRMM_CP002_Q0001"]}[Data],
				    
				    // ========== 月份循环配置 ==========
				    起始月份 = p_月报起始日期,
				    结束月份 = p_月报终止日期,
				    月份序列 = List.Generate(() => 起始月份, each _ <= 结束月份, each Date.AddMonths(_, 1)),
				    月份文本列表 = List.Transform(月份序列, each Text.From(Date.Year(_) * 100 + Date.Month(_))),
				    
				    // ========== 单月取数函数 ==========
				    查询单月 = (month as text) =>
				        let
				            Query = Cube.Transform(基础查询, {
				                // BW期间参数
				                {Cube.ApplyParameter, "[ZMSDQNY]", {month}},
				                
				                // 维度字段展开
				                {Cube.AddAndExpandDimensionColumn, "[4ZRMM_CP002-ZKL]", {"[4ZRMM_CP002-ZKL].[LEVEL01]"}, {"分类"}},
				                {Cube.AddAndExpandDimensionColumn, "[4VGQHR12MHZ3FVOJ91YJ55O51]", {"[4VGQHR12MHZ3FVOJ91YJ55O51]"}, {"结构"}},
				                {Cube.AddAndExpandDimensionColumn, "[ZKT]", {"[ZKT].[LEVEL01]"}, {"矿体"}},
				                
				                // 度量值
				                {Cube.AddMeasureColumn, "金额(人民币)", "[4VGQHR12MHZ3FVOJ91YJ55HTH].[4VGQHR12MHZ1PLAV995LXI93I]"},
				                {Cube.AddMeasureColumn, "量(吨)", "[4VGQHR12MHZ3FVOJ91YJ55HTH].[4VGQHR12MHZ1PLAV995LXI2RY]"}
				            }),
				            
				            // ✅ 新增：对结构列做前后截断（去掉空格）
				            截断结构列 = Table.TransformColumns(Query, {{"结构", Text.Trim, type text}}),
				            
				            // 增加加载年月列
				            附加月份 = Table.AddColumn(截断结构列, "加载年月", each month, type text)
				        in
				            附加月份,
				    
				    // 遍历月份，逐个查询
				    各月结果 = List.Transform(月份文本列表, 查询单月),
				    
				    // 合并所有月份结果
				    合并结果 = Table.Combine(各月结果),
				    
				    // ========== 左连接映射表，带出三个排序 ==========
				    左连接分类排序 = Table.NestedJoin(合并结果, {"分类"}, 分类排序表, {"分类"}, "分类映射临时", JoinKind.LeftOuter),
				    展开分类排序 = Table.ExpandTableColumn(左连接分类排序, "分类映射临时", {"分类排序"}, {"分类排序"}),
				    
				    左连接结构排序 = Table.NestedJoin(展开分类排序, {"结构"}, 结构排序表, {"结构"}, "结构映射临时", JoinKind.LeftOuter),
				    展开结构排序 = Table.ExpandTableColumn(左连接结构排序, "结构映射临时", {"结构排序"}, {"结构排序"}),
				    
				    左连接矿体排序 = Table.NestedJoin(展开结构排序, {"矿体"}, 矿体排序表, {"矿体"}, "矿体映射临时", JoinKind.LeftOuter),
				    展开矿体排序 = Table.ExpandTableColumn(左连接矿体排序, "矿体映射临时", {"矿体排序"}, {"矿体排序"})
				in
				    展开矿体排序
				```

	annotation PBI_ResultType = Table

